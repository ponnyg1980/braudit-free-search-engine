void automation.tmh_freesearch_on_convert(int dealId)
{
	// Lead conversion carry-through, v2 (Jonathan, 20 Aug 2026): a visitor
	// who searches several brands gets ONE lead (email dedupe) with one
	// G S Scope Asset per brand. Before converting, the rep sets
	// "Proceed With" on each brand's asset row (Brand Audit / UK Trademark
	// Application / Not Proceeding). Convert once -> one Contact, one
	// Account, and this function fans out ONE DEAL PER TICKED BRAND:
	//
	//  - the deal Zoho made at conversion is claimed by the first
	//    proceeding brand (preferring the brand whose session the deal
	//    carries), its asset linked + Active;
	//  - every other proceeding brand gets a NEW deal (pipeline by type,
	//    Stage "Prospect"), its asset linked + Active;
	//  - non-proceeding brands stay Draft, parked on the Account so
	//    nothing is lost if the client comes back.
	//
	// If NO asset carries a Proceed With tick (the pre-v2 flow), behaviour
	// is unchanged: the session-matched asset rides the conversion deal.
	//
	// Runs from the DEALS on-create workflow (criteria: Free Search
	// Session is not empty). Deals created HERE deliberately omit the
	// {"trigger":...} options map, so this workflow does NOT re-fire for
	// them - no recursion.
	deal = zoho.crm.getRecordById("Deals",dealId);
	if(deal == null)
	{
		info "on_convert: deal " + dealId + " not readable";
		return;
	}
	sess = "";
	if(deal.get("Free_Search_Session") != null)
	{
		sess = deal.get("Free_Search_Session").toString();
	}
	if(sess == "")
	{
		return;
	}
	// Session -> lead id (plain-text stamp that survives conversion) ->
	// ALL of this lead's brand assets.
	found = zoho.crm.searchRecords("G_S_Scope_Assets","(Free_Search_Session:equals:" + sess + ")");
	fsLead = "";
	for each a in found
	{
		if(fsLead == "" && a.get("Free_Search_Lead_Id") != null && a.get("Free_Search_Lead_Id") != "")
		{
			fsLead = a.get("Free_Search_Lead_Id").toString();
		}
	}
	sibs = found;
	if(fsLead != "")
	{
		sibs = zoho.crm.searchRecords("G_S_Scope_Assets","(Free_Search_Lead_Id:equals:" + fsLead + ")");
	}
	acctId = "";
	if(deal.get("Account_Name") != null)
	{
		acctId = deal.get("Account_Name").get("id").toString();
	}
	contId = "";
	if(deal.get("Contact_Name") != null)
	{
		contId = deal.get("Contact_Name").get("id").toString();
	}
	// Any per-brand ticks at all? (Legacy sessions have none.)
	anyTick = false;
	for each a in sibs
	{
		if(a.get("Asset_Type") == "Deal Search" && a.get("Proceed_With") != null && a.get("Proceed_With") != "")
		{
			anyTick = true;
		}
	}
	// Which asset claims the conversion deal. Priority (fixed 21 Aug after
	// the first real conversion crossed brands): 1) the brand NAMED in the
	// deal the rep created at conversion — the rep's naming is intent;
	// 2) the session-matched proceeding brand (the lead's session field is
	// just the LATEST search, so this is only a fallback); 3) the first
	// proceeding brand; legacy untucked flow unchanged.
	dealNameLc = "";
	if(deal.get("Deal_Name") != null)
	{
		dealNameLc = deal.get("Deal_Name").toString().toLowerCase();
	}
	convAssetId = "";
	firstGo = "";
	for each a in sibs
	{
		if(a.get("Asset_Type") == "Deal Search")
		{
			pw = "";
			if(a.get("Proceed_With") != null)
			{
				pw = a.get("Proceed_With").toString();
			}
			goes = false;
			if(pw == "Brand Audit" || pw == "UK Trademark Application")
			{
				goes = true;
			}
			if(anyTick == false)
			{
				goes = false;
				aSess = "";
				if(a.get("Free_Search_Session") != null)
				{
					aSess = a.get("Free_Search_Session").toString();
				}
				if(aSess == sess)
				{
					goes = true;
				}
			}
			if(goes)
			{
				if(firstGo == "")
				{
					firstGo = a.get("id").toString();
				}
				brandLc = a.get("Name").toString().toLowerCase();
				if(brandLc.contains("free search - "))
				{
					brandLc = brandLc.getSuffix("free search - ");
				}
				if(brandLc.contains("brand audit - "))
				{
					brandLc = brandLc.getSuffix("brand audit - ");
				}
				if(brandLc != "" && dealNameLc.contains(brandLc))
				{
					// Rep named this brand in the conversion deal — hard claim.
					convAssetId = a.get("id").toString();
				}
				aSess2 = "";
				if(a.get("Free_Search_Session") != null)
				{
					aSess2 = a.get("Free_Search_Session").toString();
				}
				if(convAssetId == "" && aSess2 == sess)
				{
					convAssetId = a.get("id").toString();
				}
			}
		}
	}
	if(convAssetId == "")
	{
		convAssetId = firstGo;
	}
	linked = 0;
	made = 0;
	parked = 0;
	// asset id -> the deal that brand ends up on; used after the loop to
	// mirror each asset's classes into that deal's Classes Terms SUB-FORM
	// (the sub-form still drives live automations - Jonathan, 22 Aug).
	mirrorMap = Map();
	for each a in sibs
	{
		if(a.get("Asset_Type") == "Deal Search")
		{
			aid = a.get("id").toString();
			pw = "";
			if(a.get("Proceed_With") != null)
			{
				pw = a.get("Proceed_With").toString();
			}
			goes = false;
			if(pw == "Brand Audit" || pw == "UK Trademark Application")
			{
				goes = true;
			}
			if(anyTick == false)
			{
				goes = false;
				if(aid == convAssetId)
				{
					goes = true;
				}
			}
			up = Map();
			if(acctId != "")
			{
				up.put("Account",acctId.toLong());
			}
			if(goes)
			{
				up.put("Asset_Status","Active");
				if(aid == convAssetId)
				{
					up.put("Deal",dealId);
					linked = linked + 1;
					mirrorMap.put(aid,dealId.toString());
				}
				else
				{
					brand = a.get("Name").toString();
					if(brand.contains("Free Search - "))
					{
						brand = brand.getSuffix("Free Search - ");
					}
					if(brand.contains("Brand Audit - "))
					{
						brand = brand.getSuffix("Brand Audit - ");
					}
					dMap = Map();
					dMap.put("Deal_Name",brand + " - " + pw);
					if(pw == "Brand Audit")
					{
						dMap.put("Pipeline","Audit and Consultation");
					}
					else
					{
						dMap.put("Pipeline","UK Trademark Application");
					}
					dMap.put("Stage","Prospect");
					if(acctId != "")
					{
						dMap.put("Account_Name",acctId.toLong());
					}
					if(contId != "")
					{
						dMap.put("Contact_Name",contId.toLong());
					}
					if(a.get("Free_Search_Session") != null)
					{
						dMap.put("Free_Search_Session",a.get("Free_Search_Session"));
					}
					nd = zoho.crm.createRecord("Deals",dMap);
					if(nd.get("id") != null)
					{
						// Zoho ignores Pipeline/Stage on CREATE and applies the
						// layout default (proven 21 Aug: an Audit fan-out deal
						// arrived as UK Trademark Application). An UPDATE
						// applies them faithfully, so set them again.
						pMap = Map();
						pMap.put("Pipeline",dMap.get("Pipeline"));
						pMap.put("Stage","Prospect");
						pu = zoho.crm.updateRecord("Deals",nd.get("id").toString().toLong(),pMap);
						up.put("Deal",nd.get("id").toString().toLong());
						made = made + 1;
						mirrorMap.put(aid,nd.get("id").toString());
						info "on_convert: created deal " + nd.get("id") + " for asset " + aid;
					}
					else
					{
						info "on_convert: deal create FAILED for asset " + aid + ": " + nd;
					}
				}
			}
			else
			{
				parked = parked + 1;
			}
			r = zoho.crm.updateRecord("G_S_Scope_Assets",aid.toLong(),up);
		}
	}
	// ------- Sub-form mirror (22 Aug) ------------------------------------
	// For every brand that got a deal above, copy its G S class rows into
	// that deal's Classes Terms sub-form. The sub-form is still read by live
	// automations, so the search tools populate BOTH stores. Merge rule:
	// a sub-form row covering exactly ONE of our classes is replaced in
	// place; all other rows (multi-class, "All Classes", manual) are kept.
	clsPick = Map();
	clsPick.put("1","1 - Chemicals");
	clsPick.put("2","2 - Colourants");
	clsPick.put("3","3 - Toiletries");
	clsPick.put("4","4 - Fuels");
	clsPick.put("5","5 - Preparations");
	clsPick.put("6","6 - Metal");
	clsPick.put("7","7 - Machinery");
	clsPick.put("8","8 - Tools");
	clsPick.put("9","9 - Scientific Devices");
	clsPick.put("10","10 - Therapeutic Devices");
	clsPick.put("11","11 - Heating Components");
	clsPick.put("12","12 - Vehicles");
	clsPick.put("13","13 - Weapons & Explosives");
	clsPick.put("14","14 - Jewellery & Precious Minerals");
	clsPick.put("15","15 - Musical Instruments");
	clsPick.put("16","16 - Artistic Materials");
	clsPick.put("17","17 - Piping & Tubing");
	clsPick.put("18","18 - Accessories & Leather");
	clsPick.put("19","19 - Construction Materials");
	clsPick.put("20","20 - Decorative Fittings & Furniture");
	clsPick.put("21","21 - Household Utensils");
	clsPick.put("22","22 - Raw Fibres");
	clsPick.put("23","23 - Yarns & Threads");
	clsPick.put("24","24 - Textiles");
	clsPick.put("25","25 - Clothing");
	clsPick.put("26","26 - Accessories Components");
	clsPick.put("27","27 - Floor & Wall Coverings");
	clsPick.put("28","28 - Sports Equipment & Toys");
	clsPick.put("29","29 - Raw and Prepared Food");
	clsPick.put("30","30 - Convenience Food");
	clsPick.put("31","31 - Agriculture & Livestock");
	clsPick.put("32","32 - Beer & Non-Alcoholic Beverages");
	clsPick.put("33","33 - Alcoholic Beverages");
	clsPick.put("34","34 - Tobacco & Lighting Articles");
	clsPick.put("35","35 - Business Services");
	clsPick.put("36","36 - Financial Services");
	clsPick.put("37","37 - Building & Construction");
	clsPick.put("38","38 - Telecoms");
	clsPick.put("39","39 - Transport");
	clsPick.put("40","40 - Various Chemical Treatment & Energy Production");
	clsPick.put("41","41 - Education");
	clsPick.put("42","42 - I.T.");
	clsPick.put("43","43 - Hospitality");
	clsPick.put("44","44 - Animal, Environmental & Human Health Care");
	clsPick.put("45","45 - Personal & Social, Legal & Security Services");
	mirrored = 0;
	for each mAid in mirrorMap.keys()
	{
		mDeal = mirrorMap.get(mAid).toString();
		rowsM = zoho.crm.searchRecords("G_S_Scope_Classes_Terms","(Scope_Asset.id:equals:" + mAid + ")");
		ourCls = Map();
		for each rm in rowsM
		{
			nM = rm.get("Nice_Class_Number_Snapshot");
			if(nM != null && clsPick.get(nM.toLong().toString()) != null)
			{
				tM = "";
				if(rm.get("Specific_Terms") != null)
				{
					tM = rm.get("Specific_Terms").toString();
				}
				rw = Map();
				lst = List();
				lst.add(clsPick.get(nM.toLong().toString()));
				rw.put("Classes",lst);
				rw.put("Terms1",tM);
				ourCls.put(nM.toLong().toString(),rw);
			}
		}
		if(ourCls.isEmpty() == false)
		{
			dRecM = zoho.crm.getRecordById("Deals",mDeal.toLong());
			subNew = List();
			exSub = dRecM.get("Classes_Terms");
			if(exSub != null)
			{
				for each er in exSub
				{
					keep = true;
					ecl = er.get("Classes");
					if(ecl != null && ecl.size() == 1)
					{
						e1 = ecl.get(0).toString();
						if(e1.contains(" - "))
						{
							eNum = e1.getPrefix(" - ").trim();
							if(ourCls.get(eNum) != null)
							{
								tmpRw = ourCls.get(eNum);
							tmpRw.put("id",er.get("id"));
							ourCls.put(eNum,tmpRw);
								keep = false;
							}
						}
					}
					if(keep)
					{
						// id-only row = leave untouched (omitting = delete).
						kr = Map();
						kr.put("id",er.get("id"));
						subNew.add(kr);
					}
				}
			}
			for each kM in ourCls.keys()
			{
				subNew.add(ourCls.get(kM));
			}
			sfMap = Map();
			sfMap.put("Classes_Terms",subNew);
			sfU = zoho.crm.updateRecord("Deals",mDeal.toLong(),sfMap);
			mirrored = mirrored + 1;
		}
	}
	info "on_convert: deal " + dealId + " session " + sess + " linked " + linked + " created " + made + " parked " + parked + " subform-mirrored " + mirrored;
}
