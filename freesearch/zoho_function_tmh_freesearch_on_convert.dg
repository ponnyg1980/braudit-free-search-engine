void automation.tmh_freesearch_on_convert(int dealId)
{
	// Lead conversion carry-through (Jonathan, 20 Aug 2026): "When a lead
	// is converted, we need the classes and terms to carry through to the
	// Deal we create - which will usually be an Audit or a UK Trademark
	// Application."
	//
	// Zoho has no when-converted workflow trigger, so this runs from a
	// DEALS on-create workflow instead (criteria: Free Search Session is
	// not empty). The chain: the lead upsert stamps Free_Search_Session on
	// both the Lead and its G S Scope Asset; the Lead -> Deal conversion
	// mapping copies the session onto the new Deal; this function joins
	// the two and points the asset (and with it every G S Scope Classes
	// Terms row - the classes, UKIPO headings and term selections) at the
	// Deal. Nothing is copied; one version of the truth.
	deal = zoho.crm.getRecordById("Deals",dealId);
	if(deal == null)
	{
		info "on_convert: deal " + dealId + " not readable";
		return;
	}
	sess = "";
	if(deal.get("Free_Search_Session") != null)
	{
		sess = deal.get("Free_Search_Session").toString();
	}
	if(sess == "")
	{
		return;
	}
	found = zoho.crm.searchRecords("G_S_Scope_Assets","(Free_Search_Session:equals:" + sess + ")");
	linked = 0;
	for each a in found
	{
		if(a.get("Asset_Type") == "Deal Search")
		{
			up = Map();
			up.put("Deal",dealId);
			// Attached to a real matter now - promote out of Draft so
			// captured-from-web scopes and worked scopes are tellable apart.
			up.put("Asset_Status","Active");
			r = zoho.crm.updateRecord("G_S_Scope_Assets",a.get("id").toString().toLong(),up);
			linked = linked + 1;
			info "on_convert: asset " + a.get("id") + " -> deal " + dealId;
		}
	}
	info "on_convert: deal " + dealId + " session " + sess + " linked " + linked + " asset(s)";
}
