string standalone.tmh_freesearch_upsert(string crmAPIRequest)
{
	// TMH Free Search -> Leads upsert (19 Aug 2026).
	// Receives zohoPayload() pushes from the Supabase journey function;
	// ZOHO_FLOW_URL points at this function's REST API URL. The Edge
	// Function pre-maps everything: zoho_fields arrives in the module's
	// ACTUAL API values, so this stays a thin pipe - dedupe, write, callback.
	// Extended 19 Aug (Jonathan's point 1): an optional payload.scope block
	// additionally writes a G S Scope Asset for the Lead plus one G S Scope
	// Classes Terms row per picked class, so classes & specifications carry
	// into Deals / Trademark on conversion.
	reqMap = crmAPIRequest.toMap();
	bodyRaw = reqMap.get("body");
	if(bodyRaw == null)
	{
		return "no body";
	}
	payload = bodyRaw.toString().toMap();
	// ------- Register (22 Aug) -------
	// Terms vary by register (UK approved list vs US ID Manual etc). The
	// journey sends payload.register; everything today is UKIPO, but the
	// asset + row snapshots carry it so a US/EU term library can slot in
	// without a data migration.
	reg = "UKIPO";
	if(payload.get("register") != null && payload.get("register").toString() != "")
	{
		reg = payload.get("register").toString();
	}
	// ------- Deal-scoped class builder (21 Aug) -------
	// A search opened from a Deal's "Build Classes & Terms" button sends a
	// scope-only payload with zoho_deal_id: classes & UKIPO terms go straight
	// onto THAT Deal as a scope asset. No lead is read or written.
	dealTgt = "";
	if(payload.get("zoho_deal_id") != null)
	{
		dealTgt = payload.get("zoho_deal_id").toString();
	}
	if(dealTgt != "")
	{
		scopeD = payload.get("scope");
		if(scopeD == null)
		{
			return "deal:no scope";
		}
		markD = "";
		if(scopeD.get("mark") != null)
		{
			markD = scopeD.get("mark").toString();
		}
		nameD = "Class Builder - " + markD;
		if(nameD.length() > 100)
		{
			nameD = nameD.subString(0,100);
		}
		sessD = "";
		if(payload.get("session_id") != null)
		{
			sessD = payload.get("session_id").toString();
		}
		// Goods or services the visitor said the presented terms did not cover
		// (28 Aug). Written to the Scope Asset for an adviser to review before
		// anything is filed -- it is a REQUEST, never an approved term.
		extraT = "";
		if(scopeD.get("additional_terms") != null)
		{
			extraT = scopeD.get("additional_terms").toString();
		}
		// One asset per (deal, mark): re-running the button for the same
		// mark updates its rows instead of breeding duplicates.
		assetD = "";
		// Related list, not searchRecords: search lags on rows created
		// seconds earlier (proven 16 Sep) and would breed a duplicate.
		foundD = zoho.crm.getRelatedRecords("G_S_Scope_Assets","Deals",dealTgt.toLong());
		if(foundD != null)
		{
			for each ad in foundD
			{
				if(assetD == "" && ad.get("Asset_Type") == "Deal Search" && ad.get("Name") == nameD)
				{
					assetD = ad.get("id").toString();
				}
			}
		}
		// The asset links to BOTH the Deal and its Account (17 Sep).
		accD = "";
		dRecD = zoho.crm.getRecordById("Deals",dealTgt.toLong());
		if(dRecD.get("Account_Name") != null)
		{
			accD = ifnull(dRecD.get("Account_Name").get("id"),"").toString();
		}
		if(assetD == "")
		{
			amD = Map();
			amD.put("Name",nameD);
			amD.put("Deal",dealTgt.toLong());
			amD.put("Asset_Type","Deal Search");
			amD.put("Asset_Status","Active");
			amD.put("Register",reg);
			if(accD != "")
			{
				amD.put("Account",accD.toLong());
			}
			if(extraT != "")
			{
				amD.put("Additional_Terms_Request",extraT);
			}
			if(sessD != "")
			{
				amD.put("Free_Search_Session",sessD);
			}
			caD = zoho.crm.createRecord("G_S_Scope_Assets",amD);
			if(caD.get("id") != null)
			{
				assetD = caD.get("id").toString();
			}
			else
			{
				info caD;
				return "deal:asset create failed";
			}
		}
		if(assetD != "" && accD != "")
		{
			upA = Map();
			upA.put("Account",accD.toLong());
			zoho.crm.updateRecord("G_S_Scope_Assets",assetD.toLong(),upA);
		}
		existingD = Map();
		foundRD = zoho.crm.getRelatedRecords("G_S_Scope_Classes_Terms","G_S_Scope_Assets",assetD.toLong());
		if(foundRD != null)
		{
			for each rd in foundRD
			{
				if(rd.get("Nice_Class_Number_Snapshot") != null)
				{
					existingD.put(rd.get("Nice_Class_Number_Snapshot").toString(),rd.get("id").toString());
				}
			}
		}
		keptD = List();
		ordD = 0;
		madeD = 0;
		clsD = scopeD.get("classes");
		if(clsD != null)
		{
			for each cd in clsD
			{
				nD = cd.get("n");
				if(nD != null)
				{
					nnD = nD.toString();
					if(nD.toLong() < 10)
					{
						nnD = "0" + nnD;
					}
					termsD = "";
					if(cd.get("terms_text") != null)
					{
						termsD = cd.get("terms_text").toString();
					}
					ordD = ordD + 1;
					keptD.add(nD.toLong().toString());
					rMapD = Map();
					rMapD.put("Nice_Class_Number_Snapshot",nD.toLong());
					rMapD.put("Nice_Class_Reference",1964745000114603017 + nD.toLong());
					rMapD.put("Register_Snapshot",reg);
					rMapD.put("Display_Order",ordD);
					if(cd.get("display_order") != null)
					{
						rMapD.put("Display_Order",cd.get("display_order").toLong());
					}
					if(cd.get("terms_source") != null)
					{
						rMapD.put("Terms_Source",cd.get("terms_source").toString());
					}
					else
					{
						rMapD.put("Terms_Source","Approved");
					}
					if(cd.get("label") != null)
					{
						rMapD.put("Class_Description_Snapshot",cd.get("label").toString());
					}
					rMapD.put("Specific_Terms",termsD);
					if(existingD.get(nnD.toLong().toString()) != null)
					{
						ridD = existingD.get(nnD.toLong().toString());
						urD = zoho.crm.updateRecord("G_S_Scope_Classes_Terms",ridD.toLong(),rMapD);
					}
					else
					{
						rowNameD = "Class " + nnD + " - " + markD;
						if(rowNameD.length() > 100)
						{
							rowNameD = rowNameD.subString(0,100);
						}
						rMapD.put("Name",rowNameD);
						rMapD.put("Scope_Asset",assetD.toLong());
									crD = zoho.crm.createRecord("G_S_Scope_Classes_Terms",rMapD);
									if(crD.get("id") != null)
									{
										madeD = madeD + 1;
									}
								}
							}
						}
						// FINAL scope (17 Sep): classes the visitor removed before sending
						// are deleted from the asset, never left behind.
						lst_exD = existingD.keys();
						for each exD in lst_exD
						{
							if(keptD.contains(exD) == false)
							{
								delD = Map();
								delD.put("module","G_S_Scope_Classes_Terms");
								delD.put("id",existingD.get(exD));
								zoho.crm.invokeConnector("crm.delete",delD);
							}
						}
						}
		// ------- Sub-form mirror: RETIRED (Jonathan, 17 Sep 2026) ------------
		// The Deals Classes_Terms sub-form is no longer written; the G S Scope
		// Asset above is the one source of truth.
		subNote = "";
		return "ok:deal:" + dealTgt + ":scope=" + assetD + ":rows+" + madeD + subNote;
	}
	fields = payload.get("zoho_fields");
	if(fields == null)
	{
		info "no zoho_fields; skipped";
		return "skipped";
	}
	// Existing-client detection (Jonathan, 21 Aug): a search from an email
	// we already know as a Contact (or on an Account) still creates/updates
	// the Lead exactly as normal — but Lead Source Group is re-pointed to
	// "Existing Contact" / "Existing Account" so reps spot the existing
	// relationship at a glance. (Zoho accepts these values on write even
	// before they're added to the picklist — proven 21 Aug.)
	emAll = "";
	if(fields.get("Email") != null)
	{
		emAll = fields.get("Email").toString();
	}
	// ------- Lead flow rule (Jonathan, 11 Oct 2026; built 12 Oct) -------
	// "Client is paying for ongoing services - Task, client has no paid
	// subscriptions - Lead." tmh_lead_route answers paying / existing / new.
	// Paying: it has already raised a Task on the Account; write NO Lead.
	lsrcR = ifnull(fields.get("Lead_Source"),"").toString();
	actR = "Free search";
	if(lsrcR == "Quick Search")
	{
		actR = "Quick search";
	}
	else if(lsrcR == "Class Tools")
	{
		actR = "Class builder";
	}
	if(fields.get("Search_Term") != null && fields.get("Search_Term").toString() != "")
	{
		actR = actR + ": " + fields.get("Search_Term").toString();
	}
	routeR = "new";
	if(emAll != "")
	{
		routeR = standalone.tmh_lead_route(emAll,actR);
	}
	if(routeR.startsWith("paying:"))
	{
		return "ok:paying:" + routeR.getSuffix("paying:") + ":task";
	}
	if(emAll != "")
	{
		foundC = zoho.crm.searchRecords("Contacts","(Email:equals:" + emAll + ")");
		if(foundC.size() > 0)
		{
			fields.put("Lead_Source_Group","Existing Contact");
		}
		else
		{
			foundAc = zoho.crm.searchRecords("Accounts","(Email:equals:" + emAll + ")");
			if(foundAc.size() > 0)
			{
				fields.put("Lead_Source_Group","Existing Account");
			}
		}
	}
	leadId = "";
	if(payload.get("zoho_lead_id") != null)
	{
		leadId = payload.get("zoho_lead_id").toString();
	}
	// The Lead this SESSION already wrote to. A later push for the same
	// session is not a fresh engagement and must not re-engage.
	sessLeadR = leadId;
	// Email owner wins (3 Oct 2026, found testing A7a). A session's own
	// resolver Lead has no email. If the visitor's address already belongs
	// to ANOTHER Lead (a returning visitor), writing it onto the resolver
	// Lead is rejected by Zoho (Email is unique) and the push is lost without
	// an error. Update the Lead that owns the address; leave the resolver
	// Lead as it is.
	if(leadId != "" && emAll != "")
	{
		foundE = zoho.crm.searchRecords("Leads","(Email:equals:" + emAll + ")");
		if(foundE.size() > 0)
		{
			ownId = foundE.get(0).get("id").toString();
			if(ownId != leadId)
			{
				info "email owned by lead " + ownId + "; updating it, not " + leadId;
				leadId = ownId;
			}
		}
	}
	// Dedupe on Email (unique, case-insensitive on Leads): the "look for
	// the email within Zoho before creating the search item" step.
	if(leadId == "")
	{
		em = fields.get("Email");
		if(em != null && em != "")
		{
			found = zoho.crm.searchRecords("Leads","(Email:equals:" + em + ")");
			if(found.size() > 0)
			{
				leadId = found.get(0).get("id").toString();
			}
		}
	}
	isNew = false;
	if(leadId != "")
	{
		// Lead_Status is rep-managed after creation. zoho_fields never
		// carries it, so an update cannot stomp a status a rep has set.
		// The options map matters: Deluge writes do NOT fire workflow rules
		// unless asked (proven 20 Aug — the report-email rule sat silent on a
		// created lead). The Free Search Report email hangs off exactly these
		// writes, so both paths request workflow triggers explicitly.
		trg = Map();
		trg.put("trigger",{"workflow"});
		// Partner ref code (3 Oct 2026, A7a): first touch wins. A Lead that
		// already carries a Partner_Ref_Code_Used keeps it; a later session
		// with a different ref never overwrites the partner that introduced them.
		if(fields.get("Partner_Ref_Code_Used") != null)
		{
			curL = zoho.crm.getRecordById("Leads",leadId.toLong());
			curRef = ifnull(curL.get("Partner_Ref_Code_Used"),"");
			if(curRef.toString() != "")
			{
				fields.remove("Partner_Ref_Code_Used");
			}
		}
		up = zoho.crm.updateRecord("Leads",leadId.toLong(),fields,trg);
		info "update:" + up.get("id");
		// Existing open Lead engaging again (not this session's own repeat
		// push): note + "New - Re-engaging" via the ONE rule (Do Not Contact
		// keeps its status and gets a Task instead).
		if(routeR.startsWith("existing:") && leadId != sessLeadR)
		{
			reR = standalone.tmh_lead_reengage(leadId,actR);
			info "reengage:" + reR;
		}
	}
	else
	{
		// A new person always starts at "New" (12 Oct 2026; never a retired value).
		fields.put("Lead_Status","New");
		trg = Map();
		trg.put("trigger",{"workflow"});
		cr = zoho.crm.createRecord("Leads",fields,trg);
		if(cr.get("id") != null)
		{
			leadId = cr.get("id").toString();
			isNew = true;
		}
		else
		{
			info cr;
			return "create failed";
		}
	}
	// Callback: store the id on the journey row so the NEXT push for this
	// visitor updates this lead instead of creating a duplicate. Runs BEFORE
	// the scope block on purpose - if scope writing ever errors, the id
	// round-trip (the proven-critical path) has already happened.
	cb = Map();
	cb.put("zoho_lead_id",leadId);
	cb.put("zoho_lead_url","https://crm.zoho.com/crm/org628887698/tab/Leads/" + leadId);
	if(payload.get("session_id") != null)
	{
		cb.put("session_id",payload.get("session_id"));
	}
	if(payload.get("request_id") != null)
	{
		cb.put("request_id",payload.get("request_id"));
	}
	r = invokeurl
	[
		url : "https://jwanlhdmhgmbybcdhvkx.supabase.co/functions/v1/journey/zoho-linked"
		type : POST
		parameters : cb.toString()
		headers : {"Content-Type":"application/json"}
	];
	// ------- Brand Audit: many brands in one payload (27 Aug) -------
	// The audit form captures SEVERAL brands, each with its own classes and
	// terms, and pushes them as payload.brands. Search sends one brand as
	// payload.scope. Rather than a second code path, fold brands[] into the
	// same single-brand shape and let the proven block below handle each in
	// turn — so audit brands get the same assets, rows, Register and
	// Terms_Source, and inherit the conversion fan-out and Deal sub-form
	// mirror for free.
	nlA = zoho.encryption.urlDecode("%0A");
	brandsIn = payload.get("brands");
	scopeList = List();
	if(brandsIn != null)
	{
		for each bi in brandsIn
		{
			bn = "";
			if(bi.get("brand_name") != null)
			{
				bn = bi.get("brand_name").toString();
			}
			if(bn != "")
			{
				clsL = List();
				if(bi.get("classes") != null)
				{
					for each cn in bi.get("classes")
					{
						tt = "";
						if(bi.get("terms") != null)
						{
							for each tm in bi.get("terms")
							{
								if(tt != "")
								{
									tt = tt + nlA;
								}
								tt = tt + tm.toString();
							}
						}
						cRow = Map();
						cRow.put("n",cn);
						cRow.put("terms_text",tt);
						clsL.add(cRow);
					}
				}
				sMapB = Map();
				sMapB.put("mark",bn);
				sMapB.put("classes",clsL);
				sMapB.put("audit",true);
				scopeList.add(sMapB);
			}
		}
	}
	// ------- G S Scope capture (optional, idempotent) -------
	scope = payload.get("scope");
	extraT = "";
	if(scope != null)
	{
		if(scope.get("additional_terms") != null)
		{
			extraT = scope.get("additional_terms").toString();
		}
	}
	if(scope != null)
	{
		scopeList.add(scope);
	}
	scopeNote = "";
	for each scope in scopeList
	{
	if(scope != null)
	{
		mark = "";
		if(scope.get("mark") != null)
		{
			mark = scope.get("mark").toString();
		}
		// Audit brands are labelled so a rep can see at a glance which route
		// the classes came from; on_convert strips either prefix.
		assetName = "Free Search - " + mark;
		if(scope.get("audit") != null)
		{
			assetName = "Brand Audit - " + mark;
		}
		if(assetName.length() > 100)
		{
			assetName = assetName.subString(0,100);
		}
		// Find-or-create the asset for THIS lead AND THIS BRAND (20 Aug:
		// one asset per searched brand, so a visitor who searches three
		// names keeps three separate class/term sets on one lead; re-pushes
		// of the same brand reuse its asset).
		assetId = "";
		foundA = zoho.crm.getRelatedRecords("G_S_Scope_Assets","Leads",leadId.toLong());
		if(foundA != null)
		{
			for each a in foundA
			{
				if(assetId == "" && a.get("Asset_Type") == "Deal Search" && a.get("Name") == assetName)
				{
					assetId = a.get("id").toString();
				}
			}
		}
		sess = "";
		if(payload.get("session_id") != null)
		{
			sess = payload.get("session_id").toString();
		}
		if(assetId == "")
		{
			aMap = Map();
			aMap.put("Name",assetName);
			aMap.put("Lead",leadId.toLong());
			aMap.put("Asset_Type","Deal Search");
			aMap.put("Asset_Status","Draft");
			aMap.put("Register",reg);
			if(extraT != "")
			{
				aMap.put("Additional_Terms_Request",extraT);
			}
			// Survives conversion (plain text, unlike the Lead lookup):
			// on_convert uses it to gather ALL of this lead's brand assets.
			aMap.put("Free_Search_Lead_Id",leadId);
			if(sess != "")
			{
				// Conversion carry-through key: the Deal created at lead
				// conversion inherits Free_Search_Session via the Lead ->
				// Deal conversion mapping, and the Deals-on-create workflow
				// finds this asset by the same value. No converted-lead
				// reads needed anywhere.
				aMap.put("Free_Search_Session",sess);
			}
			ca = zoho.crm.createRecord("G_S_Scope_Assets",aMap);
			if(ca.get("id") != null)
			{
				assetId = ca.get("id").toString();
			}
		}
		else
		{
			sMap = Map();
			sMap.put("Free_Search_Lead_Id",leadId);
			if(sess != "")
			{
				sMap.put("Free_Search_Session",sess);
			}
			su = zoho.crm.updateRecord("G_S_Scope_Assets",assetId.toLong(),sMap);
		}
		if(assetId != "")
		{
			// Existing class rows for this asset -> class number => row id,
			// so a re-push updates instead of breeding duplicates.
			existing = Map();
			foundR = zoho.crm.getRelatedRecords("G_S_Scope_Classes_Terms","G_S_Scope_Assets",assetId.toLong());
			if(foundR != null)
			{
				for each rrow in foundR
				{
					if(rrow.get("Nice_Class_Number_Snapshot") != null)
					{
						existing.put(rrow.get("Nice_Class_Number_Snapshot").toString(),rrow.get("id").toString());
					}
				}
			}
			keptL = List();
			ordL = 0;
			madeRows = 0;
			clsList = scope.get("classes");
			if(clsList != null)
			{
				for each c in clsList
				{
					n = c.get("n");
					if(n != null)
					{
						nn = n.toString();
						if(n.toLong() < 10)
						{
							nn = "0" + nn;
						}
						// terms_text arrives pre-joined with real newlines from the
						// Edge Function (Deluge string literals cannot express \n).
						termsTxt = "";
						if(c.get("terms_text") != null)
						{
							termsTxt = c.get("terms_text").toString();
						}
						else if(c.get("terms") != null)
						{
							for each t in c.get("terms")
							{
								if(termsTxt != "")
								{
									termsTxt = termsTxt + "; ";
								}
								termsTxt = termsTxt + t.toString();
							}
						}
						ordL = ordL + 1;
						keptL.add(n.toLong().toString());
						rMap = Map();
						rMap.put("Nice_Class_Number_Snapshot",n.toLong());
						// Nice Class Reference records are contiguous:
						// class N = 1964745000114603017 + N (COQL-verified 19 Aug).
						rMap.put("Nice_Class_Reference",1964745000114603017 + n.toLong());
						rMap.put("Register_Snapshot",reg);
						rMap.put("Display_Order",ordL);
						if(c.get("display_order") != null)
						{
							rMap.put("Display_Order",c.get("display_order").toLong());
						}
						if(c.get("terms_source") != null)
						{
							rMap.put("Terms_Source",c.get("terms_source").toString());
						}
						else
						{
							rMap.put("Terms_Source","Approved");
						}
						if(c.get("label") != null)
						{
							rMap.put("Class_Description_Snapshot",c.get("label").toString());
						}
						rMap.put("Specific_Terms",termsTxt);
						if(existing.get(nn.toLong().toString()) != null)
						{
							rid = existing.get(nn.toLong().toString());
							ur = zoho.crm.updateRecord("G_S_Scope_Classes_Terms",rid.toLong(),rMap);
						}
						else
						{
							rowName = "Class " + nn + " - " + mark;
							if(rowName.length() > 100)
							{
								rowName = rowName.subString(0,100);
							}
							rMap.put("Name",rowName);
							rMap.put("Scope_Asset",assetId.toLong());
											crr = zoho.crm.createRecord("G_S_Scope_Classes_Terms",rMap);
											if(crr.get("id") != null)
											{
												madeRows = madeRows + 1;
											}
										}
									}
								}
								// FINAL scope (17 Sep): removed classes leave the asset.
								lst_exL = existing.keys();
								for each exL in lst_exL
								{
									if(keptL.contains(exL) == false)
									{
										delL = Map();
										delL.put("module","G_S_Scope_Classes_Terms");
										delL.put("id",existing.get(exL));
										zoho.crm.invokeConnector("crm.delete",delL);
									}
								}
							}
							scopeNote = scopeNote + ":scope=" + assetId + ":rows+" + madeRows;
		}
	}
	}
	// ------- Class Builder: email the visitor their selection (21 Aug) ----
	// "I would send them an email with a csv" — the journey pre-builds the
	// CSV (Deluge string literals cannot hold newlines); this just attaches
	// and sends. Only fires for Class Tools sends, never for searches.
	if(payload.get("class_csv") != null && emAll != "" && fields.get("Email_Source") != null && fields.get("Email_Source") == "Class Tools")
	{
		csvF = payload.get("class_csv").toString().toFile("trademark-classes.csv");
		markM = "";
		if(scope != null && scope.get("mark") != null && scope.get("mark") != "")
		{
			markM = " - " + scope.get("mark").toString();
		}
		// From: matt@ is a verified+authenticated org email, but Zoho CRM's
		// Deluge validator STILL rejects it in sendmail (tested 22 Aug 2026:
		// bare address, Name<addr> and Name <addr> all fail with "from must
		// be zoho.loginuserid or a verified email address"). CRM Deluge
		// sendmail only accepts zoho.loginuserid/adminuserid — org emails
		// work in workflow email notifications, not here. So the CSV email
		// sends from the executing user; the report emails DO come from
		// Matt Griffiths via the workflow notification.
		sendmail
		[
			from : zoho.loginuserid
			to : emAll
			cc : "enquiries@thetrademarkhelpline.com"
			subject : "Your trademark classes & terms" + markM
			message : "<p>Hello,</p><p>Attached are the trademark classes and specific terms you built with our Class Builder" + markM + ", as a CSV you can open in Excel or Google Sheets.</p><p>If you would like us to check the UK register for conflicts with these classes, or to file an application using them, call us on 0161 833 5400 or simply reply to this email.</p><p>The Trademark Helpline<br>Search. Register. Protect.</p>"
			Attachments : file:csvF
		]
		scopeNote = scopeNote + ":csv_emailed";
	}
	return "ok:" + leadId + ":new=" + isNew + scopeNote;
}
