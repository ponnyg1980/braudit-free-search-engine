string standalone.tmh_audit_checkout(string crmAPIRequest)
{
	// AUDIT CHECKOUT INTAKE -- the client-facing 9-page audit journey.
	//
	// Jonathan, 27 Aug 2026:
	//   'When a Brand Audit begins where we create a Lead, it converts to
	//    Contact & Deal or creates contact and deal when they get past
	//    Contact Stage - Account is populated from Details Page'
	//   'Deal Stage is Prospect until page Summary at which point it is at
	//    stage quoted. When paid, they move to Paid, Send for Research and
	//    an immediate task is created for admin@ to send for research'
	//
	// STAGED, not one-shot. The page calls this at each milestone so the
	// CRM fills in as the client progresses and an abandoned journey still
	// leaves a usable record:
	//
	//   stg=contact    Lead (source-attributed) -> convert -> Contact +
	//                    Deal at Prospect in 'Audit and Consultation'.
	//   stg=scope      searches, jurisdictions, classes & terms, platforms,
	//                    consultation -> Deal + G S Scope + exclusions.
	//   stg=applicant  Account created/matched from the Details page and
	//                    linked to the Deal and Contact.
	//   stg=summary    Stage -> Quoted, pricing + order ref recorded.
	//   stg=paid       Stage -> Paid, Next_Action -> 'Send for Research',
	//                    task for Admin Support, email to admin@.
	//   stg=factfind   the closing questions.
	//
	// Every stage is idempotent: the caller passes zoho_deal_id once it has
	// one, so re-entry updates rather than duplicates.
	//
	// PIPELINE NOTE (proven twice, 27 Aug): the v2 API DERIVES Pipeline from
	// Stage. Sending Pipeline directly reports success and silently keeps the
	// layout default. 'Prospect' exists in several pipelines, so the deal is
	// created on a stage unique to Audit and Consultation ('Initial
	// Conversation') and moved to Prospect immediately afterwards.
	reqMap = crmAPIRequest.toMap();
	bodyRaw = reqMap.get("body");
	if(bodyRaw == null)
	{
		return "no body";
	}
	p = bodyRaw.toString().toMap();
	nl = zoho.encryption.urlDecode("%0A");
	stg = "";
	if(p.get("stage") != null)
	{
		stg = p.get("stage").toString().trim().toLowerCase();
	}
	sessionId = "";
	if(p.get("session_id") != null)
	{
		sessionId = p.get("session_id").toString();
	}
	dealId = "";
	if(p.get("zoho_deal_id") != null)
	{
		dealId = p.get("zoho_deal_id").toString();
	}
	contactId = "";
	if(p.get("zoho_contact_id") != null)
	{
		contactId = p.get("zoho_contact_id").toString();
	}
	accountId = "";
	if(p.get("zoho_account_id") != null)
	{
		accountId = p.get("zoho_account_id").toString();
	}
	emIn = "";
	if(p.get("email") != null)
	{
		emIn = p.get("email").toString().trim();
	}
	// searchRecords criteria are URL-decoded by Zoho, so a '+' in an address
	// becomes a space and a plus-addressed email matches nothing at all
	// (found 28 Aug -- a Contact that existed was invisible to the search).
	// Every criteria lookup below uses the encoded form.
	// PLUS-ADDRESSING. Zoho URL-decodes searchRecords criteria, so a raw + 
	// arrives as a space; urlEncode() escapes the @ as well and breaks the
	// criteria; and %2B decodes straight back to a space. All three were
	// proven wrong on 28 Aug. So the search never contains a plus at all:
	// match on the part BEFORE it with starts_with, then confirm the exact
	// address in code.
	emPre = emIn;
	if(emIn.contains("+"))
	{
		emPre = emIn.getPrefix("+");
	}
	res = Map();
	res.put("stage",stg);
	//
	// ----------------------------------------------- stage: contact
	//
	if((stg == "contact") && (emIn != ""))
	{
		em = emIn;
		first = "";
		if(p.get("first_name") != null)
		{
			first = p.get("first_name").toString().trim();
		}
		last = "";
		if(p.get("last_name") != null)
		{
			last = p.get("last_name").toString().trim();
		}
		if(last == "")
		{
			last = em;
		}
		phone = "";
		if(p.get("phone") != null)
		{
			phone = p.get("phone").toString().trim();
		}
		mark = "";
		if(p.get("mark") != null)
		{
			mark = p.get("mark").toString().trim();
		}
		auditLink = "";
		if(p.get("audit_link") != null)
		{
			auditLink = p.get("audit_link").toString();
		}
		// 1. Existing contact wins -- a returning client is never re-led.
		foundC = zoho.crm.searchRecords("Contacts","(Email:starts_with:" + emPre + ")");
		hitC = foundC.toString();
		if(hitC.contains("id"))
		{
			// starts_with is only the NET -- every candidate is verified
			// against the full address, or a prefix-sharing sibling
			// (dominateteam1980+a vs +b) matches the wrong person. Proven
			// 28 Aug: the first prefix match was somebody else entirely.
			for each  fcrow in foundC
			{
				if((contactId == "") && (fcrow.get("Email") != null))
				{
					if(fcrow.get("Email").toString().equalsIgnoreCase(emIn))
					{
						contactId = fcrow.get("id").toString();
						acc = fcrow.get("Account_Name");
						if(acc != null)
						{
							accountId = acc.get("id").toString();
						}
					}
				}
			}
		}
		// 2. No contact: create the Lead (attribution lives here), then
		//    convert it at once -- the client has passed the contact step.
		if(contactId == "")
		{
			leadId = "";
			foundL = zoho.crm.searchRecords("Leads","(Email:starts_with:" + emPre + ")");
			hitL = foundL.toString();
			if(hitL.contains("id"))
			{
				for each  flrow in foundL
				{
					if((leadId == "") && (flrow.get("Email") != null))
					{
						if(flrow.get("Email").toString().equalsIgnoreCase(emIn))
						{
							leadId = flrow.get("id").toString();
						}
					}
				}
			}
			if(leadId == "")
			{
				lM = Map();
				lM.put("First_Name",first);
				lM.put("Last_Name",last);
				lM.put("Email",em);
				if(phone != "")
				{
					lM.put("Phone",phone);
				}
				lM.put("Company",last);
				lM.put("Lead_Source","Request Brand Audit Website Form");
				lM.put("Lead_Status","New Enquiry");
				if(auditLink != "")
				{
					lM.put("Brand_Audit_Link",auditLink);
				}
				if(sessionId != "")
				{
					lM.put("Free_Search_Session",sessionId);
				}
				lM.put("Description","Brand Audit started on the website." + nl + "Mark: " + mark);
				nl2 = zoho.crm.createRecord("Leads",lM);
				if(nl2.get("id") != null)
				{
					leadId = nl2.get("id").toString();
				}
			}
			if(leadId != "")
			{
				// Zoho's conversion mapping does NOT carry the AI fields --
				// they are not on the layouts, and the auto-map skips them
				// (proven 30 Aug: a lead with both flags true converted to a
				// contact with both false). Read them off the lead first and
				// write them onto the contact ourselves.
				aiBlk = false;
				aiSafe = false;
				ldRec = zoho.crm.getRecordById("Leads",leadId.toLong());
				if(ldRec.get("AI_Tools_Blocked") != null)
				{
					aiBlk = ldRec.get("AI_Tools_Blocked").toString().equalsIgnoreCase("true");
				}
				if(ldRec.get("AI_Safe_Sender") != null)
				{
					aiSafe = ldRec.get("AI_Safe_Sender").toString().equalsIgnoreCase("true");
				}
				cMap = Map();
				cMap.put("overwrite",false);
				cMap.put("notify_lead_owner",false);
				cMap.put("notify_new_entity_owner",false);
				cv = zoho.crm.convertLead(leadId.toLong(),cMap);
				if(cv.get("Contacts") != null)
				{
					contactId = cv.get("Contacts").toString();
				}
				if(cv.get("Accounts") != null)
				{
					accountId = cv.get("Accounts").toString();
				}
				if(contactId != "")
				{
					if(aiBlk || aiSafe)
					{
						aiC = Map();
						aiC.put("AI_Tools_Blocked",aiBlk);
						aiC.put("AI_Safe_Sender",aiSafe);
						zoho.crm.updateRecord("Contacts",contactId.toLong(),aiC);
					}
				}
			}
		}
		// 3. Still no contact (conversion refused) -- create one directly so
		//    the journey is never blocked by CRM plumbing.
		if(contactId == "")
		{
			cM = Map();
			cM.put("First_Name",first);
			cM.put("Last_Name",last);
			cM.put("Email",em);
			if(phone != "")
			{
				cM.put("Phone",phone);
			}
			cr = zoho.crm.createRecord("Contacts",cM);
			if(cr.get("id") != null)
			{
				contactId = cr.get("id").toString();
			}
		}
		// 4. The Deal. Created on a stage unique to this pipeline, then
		//    moved to Prospect (Jonathan: Prospect until Summary).
		if((dealId == "") && (contactId != ""))
		{
			dName = "Trademark Audit";
			if(mark != "")
			{
				dName = "Trademark Audit - " + mark;
			}
			dM = Map();
			dM.put("Deal_Name",dName);
			dM.put("Stage","Initial Conversation");
			dM.put("Contact_Name",contactId);
			if(accountId != "")
			{
				dM.put("Account_Name",accountId);
			}
			dM.put("Lead_Source","Request Brand Audit Website Form");
			dM.put("Closing_Date",zoho.currentdate.addDay(30));
			dM.put("Braudit_Trigger_Status","Not Ready");
			// Layout-mandatory fields (13 Sep 2026): without these the Deal cannot be
			// saved from the UI until staff fill them. Type is refined at the scope stage.
			dM.put("Lead_Source_Group","Website Forms");
			dM.put("Do_Not_Contact","Safe to Contact");
			dM.put("User_Type","Direct Client");
			dM.put("Type","Word Only");
			if(auditLink != "")
			{
				dM.put("Brand_Audit_Link",auditLink);
			}
			if(sessionId != "")
			{
				dM.put("Free_Search_Session",sessionId);
			}
			dM.put("Description","Brand Audit in progress -- started at the contact step.");
			nd = zoho.crm.createRecord("Deals",dM);
			if(nd.get("id") != null)
			{
				dealId = nd.get("id").toString();
				pM = Map();
				pM.put("Stage","Prospect");
				zoho.crm.updateRecord("Deals",dealId.toLong(),pM);
			}
		}
		res.put("zoho_contact_id",contactId);
		res.put("zoho_account_id",accountId);
		res.put("zoho_deal_id",dealId);
	}
	else if((stg == "scope") && (dealId != ""))
	{
		//
		// ----------------------------------------------- stage: scope
		//
		// Everything the audit will actually search. Written as the client
		// moves, so an abandoned journey still shows staff what was wanted.
		dM = Map();
		mark = "";
		if(p.get("mark") != null)
		{
			mark = p.get("mark").toString().trim();
		}
		tagline = "";
		if(p.get("tagline") != null)
		{
			tagline = p.get("tagline").toString().trim();
		}
		// Word criteria (intake fields -- the frozen scope is the record of
		// record; these remain the operator-facing intake per the
		// retirement map).
		if(mark != "")
		{
			dM.put("Search_Word_1",mark);
			dM.put("Search_Operator_1","Exact Match");
		}
		if(tagline != "")
		{
			dM.put("Search_Word_2",tagline);
			dM.put("Search_Operator_2","Exact Match");
		}
		// Search types: word always; image when a logo exists or is coming.
		// F1 (13 Sep 2026): ONLY when this call carries has_logo. The scope
		// stage is called twice (searches page, then consultation page); the
		// second call has no has_logo and used to reset every Deal to
		// word-only and Logo_Awaited=false.
		if(p.get("has_logo") != null)
		{
			types = List();
			types.add("Word");
			hasLogo = p.get("has_logo").toString().equalsIgnoreCase("true");
			logoLater = false;
			if(p.get("logo_later") != null)
			{
				logoLater = p.get("logo_later").toString().equalsIgnoreCase("true");
			}
			if(hasLogo)
			{
				types.add("Image");
			}
			dM.put("Braudit_Search_Types",types);
			dM.put("Logo_Awaited",logoLater);
			if(hasLogo)
			{
				dM.put("Type","Combined Word and Logo");
			}
			else
			{
				dM.put("Type","Word Only");
			}
		}
		// Jurisdictions -- trading now + planned, ISO codes.
		jur = List();
		if(p.get("trading_now") != null)
		{
			lst_c = p.get("trading_now").toList();
			for each c in lst_c
			{
				jur.add(c.toString());
			}
		}
		if(p.get("planning_to_trade") != null)
		{
			lst_c = p.get("planning_to_trade").toList();
			for each c in lst_c
			{
				if(jur.contains(c.toString()) == false)
				{
					jur.add(c.toString());
				}
			}
		}
		if(jur.size() > 0)
		{
			dM.put("Trademark_Jurisdictions",jur);
		}
		// Platform confirms -> the layers the Braudit order will carry.
		if(p.get("search_layers") != null)
		{
			layers = List();
			lst_l = p.get("search_layers").toList();
			for each l in lst_l
			{
				layers.add(l.toString());
			}
			if(layers.size() > 0)
			{
				dM.put("Audit_Search_Layers",layers);
			}
		}
		// Classes live ONLY on the G S Scope Asset (Jonathan, 17 Sep 2026):
		// the Deals `Classes` multiselect is labelled "DO NOT USE" and the
		// `Classes_Terms` sub-form is retired. Neither is written any more.
		// SCOPE RESPONSIBILITY (Jonathan, 19 Sep 2026). An ORDER-LEVEL
		// instruction, so it belongs on the Deal, never on the scope asset:
		// a "TMH to pick" order has NO class rows, so an instruction stored
		// on the asset would disappear exactly when it is needed. The three
		// values are the picklist's stored strings, sent verbatim by the
		// checkout page.
		if(p.get("scope_responsibility") != null)
		{
			sResp = p.get("scope_responsibility").toString().trim();
			if(sResp != "")
			{
				dM.put("Scope_Responsibility",sResp);
			}
		}
		// Consultation + deadline.
		if(p.get("consultation_type") != null)
		{
			dM.put("Audit_Consultation_Type",p.get("consultation_type").toString());
		}
		if(p.get("deadline") != null)
		{
			dM.put("Audit_Deadline",p.get("deadline").toString().toDate());
		}
		if(p.get("description") != null)
		{
			dM.put("Description",p.get("description").toString());
		}
		if(dM.size() > 0)
		{
			zoho.crm.updateRecord("Deals",dealId.toLong(),dM);
		}
		// ===== SCOPE WRITE (Jonathan, 17 Sep 2026) -- shared by 'scope' + 'order_complete' =====
		// The reusable asset: ONE G_S_Scope_Assets per Deal (Asset_Type "Deal Search")
		// linked to BOTH the Account and the Deal, ONE G_S_Scope_Classes_Terms child
		// per class (Nice_Class_Reference, Nice_Class_Number_Snapshot,
		// Class_Description_Snapshot, Specific_Terms "; "-joined, Terms_Source,
		// Display_Order). Re-sending REPLACES: class rows are updated in place and
		// rows for classes the user removed are deleted, so the asset is always the
		// FINAL edited scope. The Deals Classes_Terms sub-form is RETIRED (17 Sep)
		// and the "DO NOT USE" Classes multiselect is not written: this asset is
		// the one source of truth. All lookups by related list -- search lags.
		if(p.get("scope") != null)
		{
			scMark = "";
			if(p.get("mark") != null)
			{
				scMark = p.get("mark").toString().trim();
			}
			clsPick = {1:"1 - Chemicals",2:"2 - Paints",3:"3 - Cosmetics & Cleaning",4:"4 - Lubricants & Fuels",5:"5 - Pharmaceuticals",6:"6 - Metal Goods",7:"7 - Machinery",8:"8 - Hand Tools",9:"9 - Scientific Devices",10:"10 - Medical Apparatus",11:"11 - Environmental Control",12:"12 - Vehicles",13:"13 - Firearms",14:"14 - Jewellery",15:"15 - Musical Instruments",16:"16 - Paper Goods",17:"17 - Rubber Goods",18:"18 - Leather Goods",19:"19 - Building Materials",20:"20 - Furniture",21:"21 - Household Utensils",22:"22 - Ropes & Textiles",23:"23 - Yarns & Threads",24:"24 - Fabrics",25:"25 - Clothing",26:"26 - Lace & Embroidery",27:"27 - Floor Coverings",28:"28 - Toys & Sports",29:"29 - Meat & Processed Foods",30:"30 - Staple Foods",31:"31 - Natural Agricultural",32:"32 - Light Beverages",33:"33 - Wines & Spirits",34:"34 - Smokers Articles",35:"35 - Advertising & Business",36:"36 - Insurance & Finance",37:"37 - Construction & Repair",38:"38 - Telecommunications",39:"39 - Transportation",40:"40 - Treatment of Materials",41:"41 - Education & Entertainment",42:"42 - Computer & Scientific",43:"43 - Hotels & Restaurants",44:"44 - Medical & Beauty",45:"45 - Legal & Security"};
			scRows = p.get("scope").toList();
			// ---- 1. (retired 17 Sep) the Deals Classes_Terms sub-form and the
			//      "DO NOT USE" Classes multiselect are no longer written. The
			//      asset below is the ONE source of truth.
			// ---- 2. The asset: Account + Deal
			scAcc = accountId;
			if(scAcc == "")
			{
				scDR2 = zoho.crm.getRecordById("Deals",dealId.toLong());
				if(scDR2.get("Account_Name") != null)
				{
					scAcc = ifnull(scDR2.get("Account_Name").get("id"),"").toString();
				}
			}
			scANm = "Brand Audit - " + scMark;
			if(scANm.length() > 100)
			{
				scANm = scANm.subString(0,100);
			}
			assetId = "";
			scFirst = "";
			scRelA = zoho.crm.getRelatedRecords("G_S_Scope_Assets","Deals",dealId.toLong());
			if(scRelA != null)
			{
				for each  scra in scRelA
				{
					if(ifnull(scra.get("Asset_Type"),"") == "Deal Search")
					{
						// prefer OUR asset by name; a Class Builder asset may share the Deal
						if(ifnull(scra.get("Name"),"") == scANm)
						{
							assetId = scra.get("id").toString();
						}
						else if(scFirst == "")
						{
							scFirst = scra.get("id").toString();
						}
					}
				}
			}
			if((assetId == "") && (scFirst != ""))
			{
				assetId = scFirst;
			}
			scAM = Map();
			scAM.put("Name",scANm);
			scAM.put("Deal",dealId.toLong());
			scAM.put("Asset_Type","Deal Search");
			scAM.put("Asset_Status","Active");
			scAM.put("Register","UKIPO");
			if(scAcc != "")
			{
				scAM.put("Account",scAcc.toLong());
			}
			if(assetId == "")
			{
				scCA = zoho.crm.createRecord("G_S_Scope_Assets",scAM);
				if(scCA.get("id") != null)
				{
					assetId = scCA.get("id").toString();
				}
			}
			else
			{
				zoho.crm.updateRecord("G_S_Scope_Assets",assetId.toLong(),scAM);
			}
			// ---- 3. One child row per class; replace, don't append
			if(assetId != "")
			{
				scOld = Map();
				scRelR = zoho.crm.getRelatedRecords("G_S_Scope_Classes_Terms","G_S_Scope_Assets",assetId.toLong());
				if(scRelR != null)
				{
					for each  scrr in scRelR
					{
						if(scrr.get("Nice_Class_Number_Snapshot") != null)
						{
							scOld.put(scrr.get("Nice_Class_Number_Snapshot").toString(),scrr.get("id").toString());
						}
					}
				}
				scKept = List();
				scOrd = 0;
				for each  scr2 in scRows
				{
					scm2 = scr2.toMap();
					scn2 = scm2.get("n").toLong();
					scOrd = scOrd + 1;
					scnn = scn2.toString();
					if(scn2 < 10)
					{
						scnn = "0" + scnn;
					}
					scRM = Map();
					scRM.put("Nice_Class_Number_Snapshot",scn2);
					scRM.put("Nice_Class_Reference",1964745000114603017 + scn2);
					scRM.put("Register_Snapshot","UKIPO");
					scRM.put("Display_Order",scOrd);
					if(scm2.get("display_order") != null)
					{
						scRM.put("Display_Order",scm2.get("display_order").toLong());
					}
					scSrc = "Approved";
					if(scm2.get("terms_source") != null)
					{
						scSrc = scm2.get("terms_source").toString();
					}
					scRM.put("Terms_Source",scSrc);
					scDesc = "";
					if(scm2.get("heading") != null)
					{
						scDesc = scm2.get("heading").toString();
					}
					if((scDesc == "") && (scm2.get("label") != null))
					{
						scDesc = scm2.get("label").toString();
					}
					if(scDesc == "")
					{
						scDesc = ifnull(clsPick.get(scn2),"Class " + scn2);
					}
					scRM.put("Class_Description_Snapshot",scDesc);
					scTx = "";
					if(scm2.get("terms_text") != null)
					{
						scTx = scm2.get("terms_text").toString();
					}
					scRM.put("Specific_Terms",scTx);
					scKept.add(scn2.toString());
					if(scOld.get(scn2.toString()) != null)
					{
						zoho.crm.updateRecord("G_S_Scope_Classes_Terms",scOld.get(scn2.toString()).toLong(),scRM);
					}
					else
					{
						scRNm = "Class " + scnn + " - " + scMark;
						if(scRNm.length() > 100)
						{
							scRNm = scRNm.subString(0,100);
						}
						scRM.put("Name",scRNm);
						scRM.put("Scope_Asset",assetId.toLong());
						zoho.crm.createRecord("G_S_Scope_Classes_Terms",scRM);
					}
				}
				// Classes the user removed before sending: gone from the asset.
				lst_scOld = scOld.keys();
				for each  scok in lst_scOld
				{
					if(scKept.contains(scok) == false)
					{
						scDel = Map();
						scDel.put("module","G_S_Scope_Classes_Terms");
						scDel.put("id",scOld.get(scok));
						zoho.crm.invokeConnector("crm.delete",scDel);
					}
				}
				res.put("scope_asset_id",assetId);
			}
		}
		// Client-owned exclusions: their own company number and domain must
		// never come back as conflicts.
		if(p.get("exclusions") != null)
		{
			lst_ex = p.get("exclusions").toList();
			for each ex in lst_ex
			{
				exm = ex.toMap();
				val = "";
				if(exm.get("value") != null)
				{
					val = exm.get("value").toString().trim();
				}
				if(val != "")
				{
					xM = Map();
					xM.put("Name",val);
					xM.put("Exclusion_Value",val);
					xM.put("Target_Type",exm.get("type").toString());
					mm = "Exact";
					if(exm.get("match_mode") != null)
					{
						mm = exm.get("match_mode").toString();
					}
					xM.put("Match_Mode",mm);
					xM.put("Reason","Client-Owned");
					xM.put("Active",true);
					xM.put("Source_Type","Client-Auto-Promoted");
					if(accountId != "")
					{
						xM.put("Account",accountId);
					}
					xM.put("Exclusion_Notes","Declared in the Brand Audit form, deal " + dealId);
					zoho.crm.createRecord("Client_Search_Exclusions",xM);
				}
			}
		}
		res.put("ok",true);
	}
	else if(stg == "applicant")
	{
		//
		// ----------------------------------------------- stage: applicant
		//
		// The Details page is where the Account comes from (Jonathan: 'Account
		// is populated from Details Page'). Company number is the dedupe key
		// when we have one, name otherwise.
		orgName = "";
		if(p.get("org_name") != null)
		{
			orgName = p.get("org_name").toString().trim();
		}
		orgId = "";
		if(p.get("org_id") != null)
		{
			orgId = p.get("org_id").toString().trim();
		}
		// Company URN is the TEXT company-number field Jonathan added on
		// 28 Aug. Text, so it holds SC/NI/OC prefixes and leading zeroes
		// exactly as Companies House issues them -- the numeric
		// Company_Registration field mangles both, which is why the dedupe
		// key moved here.
		if((accountId == "") && (orgId != ""))
		{
			fa = zoho.crm.searchRecords("Accounts","(Company_URN:equals:" + orgId + ")");
			hitA = fa.toString();
			if(hitA.contains("id"))
			{
				fa0 = fa.get(0);
				if(fa0 != null)
				{
					if(fa0.get("id") != null)
					{
						accountId = fa0.get("id").toString();
					}
				}
			}
		}
		if(accountId == "")
		{
			fa2 = zoho.crm.searchRecords("Accounts","(Account_Name:equals:" + orgName + ")");
			hitB = fa2.toString();
			if(hitB.contains("id"))
			{
				fb0 = fa2.get(0);
				if(fb0 != null)
				{
					if(fb0.get("id") != null)
					{
						accountId = fb0.get("id").toString();
					}
				}
			}
		}
		aM = Map();
		aM.put("Account_Name",orgName);
		if(orgId != "")
		{
			aM.put("Company_URN",orgId);
		}
		if(p.get("addr1") != null)
		{
			aM.put("Billing_Street",p.get("addr1").toString());
		}
		if(p.get("addr2") != null)
		{
			aM.put("Billing_City",p.get("addr2").toString());
		}
		if(p.get("addr3") != null)
		{
			aM.put("Billing_State",p.get("addr3").toString());
		}
		if(p.get("postcode") != null)
		{
			aM.put("Billing_Code",p.get("postcode").toString());
		}
		if(p.get("country") != null)
		{
			aM.put("Billing_Country",p.get("country").toString());
		}
		if(accountId == "")
		{
			ar = zoho.crm.createRecord("Accounts",aM);
			if(ar.get("id") != null)
			{
				accountId = ar.get("id").toString();
			}
		}
		else
		{
			zoho.crm.updateRecord("Accounts",accountId.toLong(),aM);
		}
		if(accountId != "")
		{
			if(contactId != "")
			{
				cU = Map();
				cU.put("Account_Name",accountId);
				zoho.crm.updateRecord("Contacts",contactId.toLong(),cU);
			}
			if(dealId != "")
			{
				dU = Map();
				dU.put("Account_Name",accountId);
				zoho.crm.updateRecord("Deals",dealId.toLong(),dU);
			}
		}
		res.put("zoho_account_id",accountId);
	}
	else if((stg == "summary") && (dealId != ""))
	{
		//
		// ----------------------------------------------- stage: summary
		//
		// 'Deal Stage is Prospect until page Summary at which point it is at
		// stage quoted.'
		dM = Map();
		dM.put("Stage","Quoted");
		dM.put("Braudit_Trigger_Status","Awaiting Payment");
		if(p.get("order_ref") != null)
		{
			dM.put("Audit_Order_Ref",p.get("order_ref").toString());
		}
		// Payment intent is known at quote time for the invoice route: the
		// client has chosen the method and the date the invoice must be paid
		// by (2 working days before their deadline). Recorded now so staff can
		// chase it without waiting for the payment itself.
		if(p.get("payment_method") != null)
		{
			dM.put("Audit_Payment_Method",p.get("payment_method").toString());
		}
		if(p.get("payment_due") != null)
		{
			dM.put("Payment_Due_Date",p.get("payment_due").toString().toDate());
		}
		if(p.get("net_total") != null)
		{
			dM.put("Amount",p.get("net_total").toDecimal());
		}
		if(p.get("vat") != null)
		{
			dM.put("VAT",p.get("vat").toDecimal());
		}
		if(p.get("total") != null)
		{
			dM.put("Order_Total",p.get("total").toDecimal());
		}
		if(p.get("deal_name") != null)
		{
			dM.put("Deal_Name",p.get("deal_name").toString());
		}
		if(p.get("description") != null)
		{
			dM.put("Description",p.get("description").toString());
		}
		zoho.crm.updateRecord("Deals",dealId.toLong(),dM);
		res.put("ok",true);
	}
	else if((stg == "paid") && (dealId != ""))
	{
		//
		// ----------------------------------------------- stage: paid
		//
		// REFUSED since 13 Sep 2026 (Jonathan): a Deal becomes Paid only on
		// a payment FACT -- the Stripe webhook or Xero confirmation -- which
		// arrive through /xero/process -> stage order_complete. A browser
		// saying "paid" is not evidence of anything. The old browser-driven
		// Paid + Send for Research + task + admin email lived here until
		// 13 Sep 2026 (repo history: zoho_function_tmh_audit_checkout.dg
		// before commit fd9c6efb). NOTE: Zoho's Deluge compiler rejects
		// statements after a return ("Improper Statement", proven 13 Sep),
		// so the old body is removed rather than short-circuited.
		res.put("ok",false);
		res.put("error","stage 'paid' is not accepted from the checkout; payment is confirmed server-side");
	}
	else if(stg == "order_complete")
	{
		//
		// ----------------------------------------- stage: order_complete
		//
		// SERVER-DRIVEN (journey /xero/process, 8 Sep) -- fires after the
		// Xero invoice exists, for BOTH payment scenarios and BOTH forms.
		// Unlike 'paid' (browser-driven, client checkout only), this stage
		// can also create the Deal when none exists yet (staff orders), and
		// it carries the invoice number, deadline and ownership rules:
		//   * kind=paid    -> Stage Paid,     Next Action Send for Research
		//   * kind=invoice -> Stage Invoiced, Next Action Confirm Payment
		//   * Deadline (Deadline Date) = consultation date when supplied,
		//     else copied from the Deal's Audit_Deadline
		//   * Owner + Next_Action_Owner = the staff user who took the order,
		//     or Admin Support (support@) for online orders
		//   * fast_track=requested -> NEXT_ACTION1 'Approve/Reject Fast
		//     Track' + approval email to support@ with one-click links
		//
		// Owner map: the six active CRM users, keyed by email. A userlookup
		// takes the user id; an unknown email falls back to Admin Support.
		owners = Map();
		owners.put("alex@thetrademarkhelpline.com","1964745000009819001");
		owners.put("kayleigh@thetrademarkhelpline.com","1964745000018749001");
		owners.put("jon@thetrademarkhelpline.com","1964745000033839001");
		owners.put("matt@thetrademarkhelpline.com","1964745000035362001");
		owners.put("saad@thetrademarkhelpline.com","1964745000040621001");
		owners.put("support@thetrademarkhelpline.com","1964745000036444001");
		staffEm = "";
		if(p.get("staff_email") != null)
		{
			staffEm = p.get("staff_email").toString().trim().toLowerCase();
		}
		ownerId = "1964745000036444001";
		if((staffEm != "") && (owners.get(staffEm) != null))
		{
			ownerId = owners.get(staffEm);
		}
		kind = "paid";
		if(p.get("kind") != null)
		{
			kind = p.get("kind").toString();
		}
		ft = "";
		if(p.get("fast_track") != null)
		{
			ft = p.get("fast_track").toString();
		}
		// ---- resolve or create the Deal --------------------------------
		// Reconcile path (13 Sep 2026): a Xero invoice paid later by GoCardless or
		// bank transfer arrives here with only the invoice number. The Deal already
		// exists from the invoice stage -- find it by Invoice_Number, never recreate.
		if((dealId == "") && (p.get("invoice_number") != null))
		{
			invNo = p.get("invoice_number").toString().trim();
			if(invNo != "")
			{
				fndInv = zoho.crm.searchRecords("Deals","(Invoice_Number:equals:" + invNo + ")");
				if(fndInv.toString().contains("id"))
				{
					fi0 = fndInv.get(0);
					if((fi0 != null) && (fi0.get("id") != null))
					{
						dealId = fi0.get("id").toString();
						res.put("zoho_deal_id",dealId);
						res.put("deal_found_by","invoice_number");
					}
				}
			}
		}
		if((dealId == "") && (emIn != ""))
		{
			// Staff orders have no browser-built Deal. Find the Contact by
			// email (plus-addressing rule: search the prefix, verify exact),
			// then create a Deal owned by the right user.
			cid = "";
			acc2Id = "";
			// Point 2/10 (9 Sep): the staff form may hand us the EXACT records
			// the staff member linked -- use them, never re-guess from email.
			if(p.get("zoho_contact_id") != null)
			{
				cid = p.get("zoho_contact_id").toString();
			}
			if(p.get("zoho_account_id") != null)
			{
				acc2Id = p.get("zoho_account_id").toString();
			}
			srch = List();
			if(cid == "")
			{
				srch = zoho.crm.searchRecords("Contacts","(Email:starts_with:" + emPre + ")");
			}
			for each  rec in srch
			{
				if((rec.get("Email") != null) && rec.get("Email").toString().equalsIgnoreCase(emIn))
				{
					cid = rec.get("id").toString();
					break;
				}
			}
			// No Contact -> is there a LEAD? A staff audit launched from a
			// search lead must CONVERT it (Jonathan, 9 Sep), never leave a
			// duplicate behind. Same pattern as the contact stage, including
			// the AI-fields carry-over (conversion drops them -- proven
			// 30 Aug).
			// The staff member may have linked the exact Lead -- convert THAT one.
			if((cid == "") && (p.get("zoho_lead_id") != null))
			{
				ldIdIn = p.get("zoho_lead_id").toString();
				if(ldIdIn != "")
				{
					aiBlk3 = false;
					aiSafe3 = false;
					ldRec3 = zoho.crm.getRecordById("Leads",ldIdIn.toLong());
					if(ldRec3.get("AI_Tools_Blocked") != null)
					{
						aiBlk3 = ldRec3.get("AI_Tools_Blocked").toString().equalsIgnoreCase("true");
					}
					if(ldRec3.get("AI_Safe_Sender") != null)
					{
						aiSafe3 = ldRec3.get("AI_Safe_Sender").toString().equalsIgnoreCase("true");
					}
					cMap3 = Map();
					cMap3.put("overwrite",false);
					cMap3.put("notify_lead_owner",false);
					cMap3.put("notify_new_entity_owner",false);
					cv3 = zoho.crm.convertLead(ldIdIn.toLong(),cMap3);
					if(cv3.get("Contacts") != null)
					{
						cid = cv3.get("Contacts").toString();
					}
					if(cv3.get("Accounts") != null)
					{
						acc2Id = cv3.get("Accounts").toString();
					}
					if((cid != "") && (aiBlk3 || aiSafe3))
					{
						aiC3 = Map();
						aiC3.put("AI_Tools_Blocked",aiBlk3);
						aiC3.put("AI_Safe_Sender",aiSafe3);
						zoho.crm.updateRecord("Contacts",cid.toLong(),aiC3);
					}
				}
			}
			if(cid == "")
			{
				fndLd2 = zoho.crm.searchRecords("Leads","(Email:starts_with:" + emPre + ")");
				for each  ldr2 in fndLd2
				{
					if((ldr2.get("Email") != null) && ldr2.get("Email").toString().equalsIgnoreCase(emIn))
					{
						aiBlk2 = false;
						aiSafe2 = false;
						if(ldr2.get("AI_Tools_Blocked") != null)
						{
							aiBlk2 = ldr2.get("AI_Tools_Blocked").toString().equalsIgnoreCase("true");
						}
						if(ldr2.get("AI_Safe_Sender") != null)
						{
							aiSafe2 = ldr2.get("AI_Safe_Sender").toString().equalsIgnoreCase("true");
						}
						cMap2 = Map();
						cMap2.put("overwrite",false);
						cMap2.put("notify_lead_owner",false);
						cMap2.put("notify_new_entity_owner",false);
						cv2 = zoho.crm.convertLead(ldr2.get("id").toString().toLong(),cMap2);
						if(cv2.get("Contacts") != null)
						{
							cid = cv2.get("Contacts").toString();
						}
						if(cv2.get("Accounts") != null)
						{
							acc2Id = cv2.get("Accounts").toString();
						}
						if((cid != "") && (aiBlk2 || aiSafe2))
						{
							aiC2 = Map();
							aiC2.put("AI_Tools_Blocked",aiBlk2);
							aiC2.put("AI_Safe_Sender",aiSafe2);
							zoho.crm.updateRecord("Contacts",cid.toLong(),aiC2);
						}
						break;
					}
				}
			}
			if(cid == "")
			{
				cM = Map();
				fn = "";
				if(p.get("first_name") != null)
				{
					fn = p.get("first_name").toString();
				}
				ln = emIn;
				if(p.get("last_name") != null)
				{
					ln = p.get("last_name").toString();
				}
				cM.put("First_Name",fn);
				cM.put("Last_Name",ln);
				cM.put("Email",emIn);
				if(p.get("phone") != null)
				{
					cM.put("Phone",p.get("phone").toString());
				}
				cM.put("Owner",ownerId);
				cr = zoho.crm.createRecord("Contacts",cM);
				if(cr.get("id") != null)
				{
					cid = cr.get("id").toString();
				}
			}
			mk = "Trademark Audit";
			if(p.get("mark") != null)
			{
				mk = p.get("mark").toString();
			}
			dNew = Map();
			dNew.put("Deal_Name","Trademark Audit & Consultation - " + mk);
			dNew.put("Stage","Prospect");
			dNew.put("Pipeline","Standard (Standard)");
			dNew.put("Owner",ownerId);
			// Layout-mandatory fields (13 Sep 2026). The staff form asks for the
			// lead source (14 Sep 2026) and sends it; "Other" is only reached by
			// an older saved enquiry, and says "not captured" rather than
			// inventing an email lead in the source reporting.
			lsg = "Other";
			if(p.get("lead_source_group") != null)
			{
				lsg = p.get("lead_source_group").toString();
			}
			dNew.put("Lead_Source_Group",lsg);
			dNew.put("Do_Not_Contact","Safe to Contact");
			dNew.put("User_Type","Staff");
			tyNew = "Word Only";
			if((p.get("search_types") != null) && p.get("search_types").toString().containsIgnoreCase("image"))
			{
				tyNew = "Combined Word and Logo";
			}
			dNew.put("Type",tyNew);
			if(cid != "")
			{
				dNew.put("Contact_Name",cid);
			}
			if(acc2Id != "")
			{
				dNew.put("Account_Name",acc2Id);
			}
			if(p.get("session_id") != null)
			{
				dNew.put("Audit_Order_Ref",p.get("session_id").toString());
			}
			dcr = zoho.crm.createRecord("Deals",dNew);
			if(dcr.get("id") != null)
			{
				dealId = dcr.get("id").toString();
				res.put("zoho_deal_id",dealId);
			}
		}
		if(dealId != "")
		{
			// Staff orders arrive with their classes & terms HERE (17 Sep):
			// the client wizard wrote them at the 'scope' stage, the staff
			// forms had nowhere to -- so the gate below failed every staff
			// order on "Nice classes and terms". Same shared block.
			// ===== SCOPE WRITE (Jonathan, 17 Sep 2026) -- shared by 'scope' + 'order_complete' =====
			// The reusable asset: ONE G_S_Scope_Assets per Deal (Asset_Type "Deal Search")
			// linked to BOTH the Account and the Deal, ONE G_S_Scope_Classes_Terms child
			// per class (Nice_Class_Reference, Nice_Class_Number_Snapshot,
			// Class_Description_Snapshot, Specific_Terms "; "-joined, Terms_Source,
			// Display_Order). Re-sending REPLACES: class rows are updated in place and
			// rows for classes the user removed are deleted, so the asset is always the
			// FINAL edited scope. The Deals Classes_Terms sub-form is RETIRED (17 Sep)
			// and the "DO NOT USE" Classes multiselect is not written: this asset is
			// the one source of truth. All lookups by related list -- search lags.
			if(p.get("scope") != null)
			{
				scMark = "";
				if(p.get("mark") != null)
				{
					scMark = p.get("mark").toString().trim();
				}
				clsPick = {1:"1 - Chemicals",2:"2 - Paints",3:"3 - Cosmetics & Cleaning",4:"4 - Lubricants & Fuels",5:"5 - Pharmaceuticals",6:"6 - Metal Goods",7:"7 - Machinery",8:"8 - Hand Tools",9:"9 - Scientific Devices",10:"10 - Medical Apparatus",11:"11 - Environmental Control",12:"12 - Vehicles",13:"13 - Firearms",14:"14 - Jewellery",15:"15 - Musical Instruments",16:"16 - Paper Goods",17:"17 - Rubber Goods",18:"18 - Leather Goods",19:"19 - Building Materials",20:"20 - Furniture",21:"21 - Household Utensils",22:"22 - Ropes & Textiles",23:"23 - Yarns & Threads",24:"24 - Fabrics",25:"25 - Clothing",26:"26 - Lace & Embroidery",27:"27 - Floor Coverings",28:"28 - Toys & Sports",29:"29 - Meat & Processed Foods",30:"30 - Staple Foods",31:"31 - Natural Agricultural",32:"32 - Light Beverages",33:"33 - Wines & Spirits",34:"34 - Smokers Articles",35:"35 - Advertising & Business",36:"36 - Insurance & Finance",37:"37 - Construction & Repair",38:"38 - Telecommunications",39:"39 - Transportation",40:"40 - Treatment of Materials",41:"41 - Education & Entertainment",42:"42 - Computer & Scientific",43:"43 - Hotels & Restaurants",44:"44 - Medical & Beauty",45:"45 - Legal & Security"};
				scRows = p.get("scope").toList();
				// ---- 1. (retired 17 Sep) the Deals Classes_Terms sub-form and the
				//      "DO NOT USE" Classes multiselect are no longer written. The
				//      asset below is the ONE source of truth.
				// ---- 2. The asset: Account + Deal
				scAcc = accountId;
				if(scAcc == "")
				{
					scDR2 = zoho.crm.getRecordById("Deals",dealId.toLong());
					if(scDR2.get("Account_Name") != null)
					{
						scAcc = ifnull(scDR2.get("Account_Name").get("id"),"").toString();
					}
				}
				scANm = "Brand Audit - " + scMark;
				if(scANm.length() > 100)
				{
					scANm = scANm.subString(0,100);
				}
				assetId = "";
				scFirst = "";
				scRelA = zoho.crm.getRelatedRecords("G_S_Scope_Assets","Deals",dealId.toLong());
				if(scRelA != null)
				{
					for each  scra in scRelA
					{
						if(ifnull(scra.get("Asset_Type"),"") == "Deal Search")
						{
							// prefer OUR asset by name; a Class Builder asset may share the Deal
							if(ifnull(scra.get("Name"),"") == scANm)
							{
								assetId = scra.get("id").toString();
							}
							else if(scFirst == "")
							{
								scFirst = scra.get("id").toString();
							}
						}
					}
				}
				if((assetId == "") && (scFirst != ""))
				{
					assetId = scFirst;
				}
				scAM = Map();
				scAM.put("Name",scANm);
				scAM.put("Deal",dealId.toLong());
				scAM.put("Asset_Type","Deal Search");
				scAM.put("Asset_Status","Active");
				scAM.put("Register","UKIPO");
				if(scAcc != "")
				{
					scAM.put("Account",scAcc.toLong());
				}
				if(assetId == "")
				{
					scCA = zoho.crm.createRecord("G_S_Scope_Assets",scAM);
					if(scCA.get("id") != null)
					{
						assetId = scCA.get("id").toString();
					}
				}
				else
				{
					zoho.crm.updateRecord("G_S_Scope_Assets",assetId.toLong(),scAM);
				}
				// ---- 3. One child row per class; replace, don't append
				if(assetId != "")
				{
					scOld = Map();
					scRelR = zoho.crm.getRelatedRecords("G_S_Scope_Classes_Terms","G_S_Scope_Assets",assetId.toLong());
					if(scRelR != null)
					{
						for each  scrr in scRelR
						{
							if(scrr.get("Nice_Class_Number_Snapshot") != null)
							{
								scOld.put(scrr.get("Nice_Class_Number_Snapshot").toString(),scrr.get("id").toString());
							}
						}
					}
					scKept = List();
					scOrd = 0;
					for each  scr2 in scRows
					{
						scm2 = scr2.toMap();
						scn2 = scm2.get("n").toLong();
						scOrd = scOrd + 1;
						scnn = scn2.toString();
						if(scn2 < 10)
						{
							scnn = "0" + scnn;
						}
						scRM = Map();
						scRM.put("Nice_Class_Number_Snapshot",scn2);
						scRM.put("Nice_Class_Reference",1964745000114603017 + scn2);
						scRM.put("Register_Snapshot","UKIPO");
						scRM.put("Display_Order",scOrd);
						if(scm2.get("display_order") != null)
						{
							scRM.put("Display_Order",scm2.get("display_order").toLong());
						}
						scSrc = "Approved";
						if(scm2.get("terms_source") != null)
						{
							scSrc = scm2.get("terms_source").toString();
						}
						scRM.put("Terms_Source",scSrc);
						scDesc = "";
						if(scm2.get("heading") != null)
						{
							scDesc = scm2.get("heading").toString();
						}
						if((scDesc == "") && (scm2.get("label") != null))
						{
							scDesc = scm2.get("label").toString();
						}
						if(scDesc == "")
						{
							scDesc = ifnull(clsPick.get(scn2),"Class " + scn2);
						}
						scRM.put("Class_Description_Snapshot",scDesc);
						scTx = "";
						if(scm2.get("terms_text") != null)
						{
							scTx = scm2.get("terms_text").toString();
						}
						scRM.put("Specific_Terms",scTx);
						scKept.add(scn2.toString());
						if(scOld.get(scn2.toString()) != null)
						{
							zoho.crm.updateRecord("G_S_Scope_Classes_Terms",scOld.get(scn2.toString()).toLong(),scRM);
						}
						else
						{
							scRNm = "Class " + scnn + " - " + scMark;
							if(scRNm.length() > 100)
							{
								scRNm = scRNm.subString(0,100);
							}
							scRM.put("Name",scRNm);
							scRM.put("Scope_Asset",assetId.toLong());
							zoho.crm.createRecord("G_S_Scope_Classes_Terms",scRM);
						}
					}
					// Classes the user removed before sending: gone from the asset.
					lst_scOld = scOld.keys();
					for each  scok in lst_scOld
					{
						if(scKept.contains(scok) == false)
						{
							scDel = Map();
							scDel.put("module","G_S_Scope_Classes_Terms");
							scDel.put("id",scOld.get(scok));
							zoho.crm.invokeConnector("crm.delete",scDel);
						}
					}
					res.put("scope_asset_id",assetId);
				}
			}
			dealRec = zoho.crm.getRecordById("Deals",dealId.toLong());
			dM = Map();
			dM.put("Owner",ownerId);
			dM.put("Next_Action_Owner",ownerId);
			dM.put("Next_Action_Date",zoho.currentdate);
			// Point 1 (9 Sep): current + planned territories COMBINED, one ISO
			// vocabulary shared with Leads. Written to Trademark_Jurisdictions.
			if(p.get("trademark_jurisdictions") != null)
			{
				jl = List();
				jparts = p.get("trademark_jurisdictions").toString().toList(";");
				for each  jv in jparts
				{
					if(jl.contains(jv) == false)
					{
						jl.add(jv);
					}
				}
				if(jl.size() > 0)
				{
					dM.put("Trademark_Jurisdictions",jl);
				}
			}
			// Search contexts (9 Sep): tagline rides inside the WORD search
			// beside the name; the logo is the IMAGE context. Billing lines
			// and search contexts are different things by design.
			if(p.get("search_types") != null)
			{
				stl = List();
				// Deluge refuses a method chain as a for-each source
				// (proven on save, 9 Sep) -- assign it first.
				stparts = p.get("search_types").toString().toList(";");
				for each  stv in stparts
				{
					// Governed values are Title Case ('Word' / 'Image'). The form
					// sends lowercase; Zoho would store it as-is, ungoverned.
					stvN = stv.toString().trim();
					if(stvN.equalsIgnoreCase("word"))
					{
						stvN = "Word";
					}
					else if(stvN.equalsIgnoreCase("image"))
					{
						stvN = "Image";
					}
					if(stvN != "")
					{
						stl.add(stvN);
					}
				}
				dM.put("Braudit_Search_Types",stl);
			}
			if(p.get("invoice_number") != null)
			{
				dM.put("Invoice_Number",p.get("invoice_number").toString());
			}
			// Deadline Date <- consultation date; fall back to the Deal's
			// own Audit_Deadline so the client checkout path (which stamped
			// it at the scope stage) maps through too.
			if(p.get("deadline") != null)
			{
				dM.put("Deadline",p.get("deadline").toString().toDate());
			}
			else if(dealRec.get("Audit_Deadline") != null)
			{
				dM.put("Deadline",dealRec.get("Audit_Deadline").toString().toDate());
			}
			if(kind == "paid")
			{
				dM.put("Stage","Paid");
				dM.put("Paid",zoho.currentdate);
				// VALIDATION GATE (13 Sep 2026): 'Send for Research' only when
				// everything research needs is on the Deal; otherwise the Deal
				// waits at 'Set Up Order' and the Owner gets a task listing
				// what is missing. The audit engine applies the same rules as a
				// backstop (audit_engine/deal_reader.validate).
				missing = List();
				sw1 = "";
				if(dealRec.get("Search_Word_1") != null)
				{
					sw1 = dealRec.get("Search_Word_1").toString().trim();
				}
				if(sw1 == "")
				{
					missing.add("search word (Search Word 1)");
				}
				// Classes & terms now live on the G S Scope Asset (17 Sep 2026),
				// not the retired sub-form: at least one Deal Search asset with
				// at least one class row.
				gtRows = 0;
				gtA = zoho.crm.getRelatedRecords("G_S_Scope_Assets","Deals",dealId.toLong());
				if(gtA != null)
				{
					for each  gta in gtA
					{
						if((gtRows == 0) && (ifnull(gta.get("Asset_Type"),"") == "Deal Search"))
						{
							gtR = zoho.crm.getRelatedRecords("G_S_Scope_Classes_Terms","G_S_Scope_Assets",gta.get("id").toString().toLong());
							if(gtR != null)
							{
								gtRows = gtR.size();
							}
						}
					}
				}
				if(gtRows == 0)
				{
					// The gate still HOLDS the order -- an audit cannot run
					// without a scope either way. What changes (Jonathan,
					// 19 Sep 2026) is what it SAYS. A client who asked us to
					// pick is not a client who forgot, and the line used to
					// read identically for both, so the worklist could not
					// tell "chase the client" from "do the work we promised".
					// PAYLOAD FIRST, then the record. On a STAFF order this
					// same call is what writes Scope_Responsibility, so the
					// Deal still holds the old value while the gate runs --
					// read the record only and a staff "we will pick them"
					// would be reported as a plain omission on the first
					// pass. Same reasoning as the applicant resolution above:
					// the stage is fire-and-forget, so nothing can run
					// "after" it and still be seen.
					sR = "";
					if(p.get("scope_responsibility") != null)
					{
						sR = p.get("scope_responsibility").toString().trim();
					}
					if(sR == "")
					{
						sR = ifnull(dealRec.get("Scope_Responsibility"),"").toString();
					}
					if(sR == "TMH to pick classes and terms")
					{
						missing.add("Nice classes and terms -- CLIENT ASKED US TO PICK THEM");
					}
					else if(sR == "TMH to pick terms")
					{
						missing.add("Nice classes and terms -- CLIENT ASKED US TO PICK THE TERMS");
					}
					else
					{
						missing.add("Nice classes and terms (G S Scope Asset)");
					}
				}
				if(dealRec.get("Account_Name") == null)
				{
					missing.add("Account");
				}
				// APPLICANT RESOLUTION (16 Sep 2026) -- runs HERE, before the gate,
				// because this stage is fire-and-forget from the journey: nothing
				// can run applicant_link "after" it and still be seen by the gate.
				// Compact form of stage applicant_link; that stage remains for
				// re-linking from edit mode. Same rules: biller-as-applicant only
				// if the biller is not a partner; company number is the only key
				// safe to act on alone here; name-only queues for Laura.
				apSame = true;
				if(p.get("applicant_same_as_billing") != null)
				{
					apSame = p.get("applicant_same_as_billing").toString().equalsIgnoreCase("true");
				}
				apName2 = "";
				if(p.get("applicant_name") != null)
				{
					apName2 = p.get("applicant_name").toString().trim();
				}
				apNum2 = "";
				if(p.get("applicant_company_number") != null)
				{
					apNum2 = p.get("applicant_company_number").toString().trim();
				}
				apId = "";
				apNm = "";
				apStatus = "";
				apCands = List();
				if(apSame)
				{
					bl2 = dealRec.get("Account_Name");
					if(bl2 != null)
					{
						bId2 = ifnull(bl2.get("id"),"").toString();
						if(bId2 != "")
						{
							bR2 = zoho.crm.getRecordById("Accounts",bId2.toLong());
							pt2 = "";
							if(bR2.get("Partner_Type") != null)
							{
								pt2 = bR2.get("Partner_Type").toString();
							}
							if(pt2 != "")
							{
								apStatus = "Needs review";
								apCands.add(ifnull(bl2.get("name"),"") + " (" + bId2 + ") is the biller but is a " + pt2 + " partner, so cannot be the applicant");
							}
							else
							{
								apId = bId2;
								apNm = ifnull(bl2.get("name"),"");
								apStatus = "Matched";
							}
						}
					}
				}
				if((apId == "") && (apStatus == "") && (apNum2 != ""))
				{
					fa3 = zoho.crm.searchRecords("Accounts","(Company_URN:equals:" + apNum2 + ")");
					if((fa3 != null) && (fa3.size() > 0))
					{
						fa30 = fa3.get(0);
						apId = fa30.get("id").toString();
						apNm = ifnull(fa30.get("Account_Name"),"");
						apStatus = "Matched";
					}
					else
					{
						nA2 = Map();
						nA2.put("Account_Name",apName2);
						nA2.put("Applicant_name",apName2);
						nA2.put("Company_URN",apNum2);
						nA2.put("Applicant_company_number",apNum2);
						at3 = List();
						at3.add("Trademark Applicant");
						nA2.put("Account_Type_2",at3);
						nr2 = zoho.crm.createRecord("Accounts",nA2);
						if(nr2.get("id") != null)
						{
							apId = nr2.get("id").toString();
							apNm = apName2;
							apStatus = "Created";
						}
					}
				}
				if((apId == "") && (apStatus == ""))
				{
					if(apName2 != "")
					{
						apStatus = "Needs review";
						apCands.add(apName2 + " - name only; no company number, nothing safe to match on");
					}
					else
					{
						apStatus = "No applicant supplied";
					}
				}
				if(apId != "")
				{
					aR3 = zoho.crm.getRecordById("Accounts",apId.toLong());
					typs3 = List();
					if(aR3.get("Account_Type_2") != null)
					{
						lst_t3 = aR3.get("Account_Type_2").toList();
						for each  t3 in lst_t3
						{
							typs3.add(t3.toString());
						}
					}
					if(typs3.contains("Trademark Applicant") == false)
					{
						typs3.add("Trademark Applicant");
						aU3 = Map();
						aU3.put("Account_Type_2",typs3);
						zoho.crm.updateRecord("Accounts",apId.toLong(),aU3);
					}
					already2 = false;
					relJ2 = zoho.crm.getRelatedRecords("Deal_Applicant_Accounts","Deals",dealId.toLong());
					if(relJ2 != null)
					{
						for each  jr2 in relJ2
						{
							jA2 = jr2.get("Applicant_Account");
							if(jA2 != null)
							{
								if(ifnull(jA2.get("id"),"").toString() == apId)
								{
									already2 = true;
								}
							}
						}
					}
					if(already2 == false)
					{
						jN2 = ifnull(dealRec.get("Deal_Name"),"") + " - " + apNm;
						if(jN2.length() > 120)
						{
							jN2 = jN2.subString(0,120);
						}
						jM2 = Map();
						jM2.put("Name",jN2);
						jM2.put("Deal",dealId.toLong());
						jM2.put("Applicant_Account",apId.toLong());
						jM2.put("Role","Applicant");
						jM2.put("Source_Type",ifnull(p.get("applicant_source_type"),"Staff").toString());
						zoho.crm.createRecord("Deal_Applicant_Accounts",jM2);
					}
				}
				dM.put("Applicant_Match_Status",apStatus);
				if(apCands.size() > 0)
				{
					dM.put("Applicant_Candidates",apCands.toString(nl));
				}
				if((apStatus == "Needs review") || (apStatus == "No applicant supplied"))
				{
					tQ2 = Map();
					tQ2.put("Subject","Confirm applicant account -- " + ifnull(dealRec.get("Deal_Name"),""));
					tQ2.put("Description","Applicant Match Status: " + apStatus + nl + "Candidates:" + nl + apCands.toString(nl) + nl + nl + "Open the Deal, add the correct Account under Deal Applicant Accounts, then set Next Action Sub Status to 'Send for Research'.");
					tQ2.put("Status","Not Started");
					tQ2.put("Priority","High");
					tQ2.put("Due_Date",zoho.currentdate);
					tQ2.put("What_Id",dealId);
					tQ2.put("$se_module","Deals");
					tQ2.put("Owner","1964745000036444001");
					zoho.crm.createRecord("Tasks",tQ2);
				}
				// APPLICANT GATE (16 Sep 2026, Jonathan): no audit goes for research
				// without at least one Applicant Account linked. The link is the
				// Deal_Applicant_Accounts junction, NOT Applicant_1 (retired). A
				// validation rule cannot count a related list, so this is the
				// enforcement point; the Setup rule is the belt to these braces.
				// Account_Name is the BILLER and on a reseller deal is the partner,
				// so its presence says nothing about who the applicant is.
				// Related-list read, NOT searchRecords (search lags on fresh rows).
				appRows = zoho.crm.getRelatedRecords("Deal_Applicant_Accounts","Deals",dealId.toLong());
				appCount = 0;
				if(appRows != null)
				{
					appCount = appRows.size();
				}
				// A row written a moment ago in this same execution counts even if
				// the related list has not caught up yet.
				if((appCount == 0) && (apId != ""))
				{
					appCount = 1;
				}
				if(appCount == 0)
				{
					missing.add("applicant account (Deal Applicant Accounts)");
				}
				wantsImg = false;
				stypes = dealRec.get("Braudit_Search_Types");
				if(stypes != null)
				{
					for each st in stypes
					{
						if(st.toString().equalsIgnoreCase("image"))
						{
							wantsImg = true;
						}
					}
				}
				if(p.get("search_types") != null && p.get("search_types").toString().containsIgnoreCase("image"))
				{
					wantsImg = true;
				}
				if(wantsImg)
				{
					hasFile = false;
					hasVienna = false;
					imRows = dealRec.get("Image_Mark_Information");
					if(imRows != null)
					{
						for each im in imRows
						{
							if((im.get("Image_JPEG") != null) && (im.get("Image_JPEG").size() > 0))
							{
								hasFile = true;
							}
							if((im.get("Vienna_Codes") != null) && (im.get("Vienna_Codes").size() > 0))
							{
								hasVienna = true;
							}
							if((im.get("Post_S_Img_Class_Div_Sub_Div") != null) && (im.get("Post_S_Img_Class_Div_Sub_Div").toString().trim() != ""))
							{
								hasVienna = true;
							}
						}
					}
					if(!hasFile)
					{
						missing.add("logo image (Image Mark Information)");
					}
					if(!hasVienna)
					{
						missing.add("Vienna codes for the logo");
					}
				}
				if(missing.size() == 0)
				{
					dM.put("Next_Action","Send for Research");
					dM.put("Braudit_Trigger_Status","Ready to Send");
					dM.put("Braudit_Last_Error","");
				}
				else
				{
					dM.put("Next_Action","Set Up Order");
					dM.put("Braudit_Trigger_Status","Not Ready");
					dM.put("Braudit_Last_Error","Missing: " + missing.toString(", "));
					tM = Map();
					tM.put("Subject","Complete audit order information before research");
					tM.put("Description","Paid, but not sent for research. Missing: " + missing.toString(", ") + nl + "Add the information in the Deal (Triage Form) and set Next Action Sub Status to 'Send for Research'.");
					tM.put("Status","Not Started");
					tM.put("Priority","High");
					tM.put("Due_Date",zoho.currentdate);
					tM.put("What_Id",dealId);
					tM.put("$se_module","Deals");
					tM.put("Owner",ownerId);
					zoho.crm.createRecord("Tasks",tM);
					res.put("held_for","Set Up Order: " + missing.toString(", "));
				}
			}
			else
			{
				dM.put("Stage","Invoiced");
				dM.put("Next_Action","Awaiting Payment");
				if(p.get("pay_date") != null)
				{
					dM.put("Payment_Due_Date",p.get("pay_date").toString().toDate());
				}
			}
			// Scope responsibility on the STAFF path (Jonathan, 19 Sep 2026).
			// The client wizard writes it at the `scope` stage; a staff order
			// has no such stage, so the journey forwards it here from the
			// stored enquiry -- the same source _staff_gate reads for G-03,
			// so the Deal and the gate cannot disagree.
			if(p.get("scope_responsibility") != null)
			{
				sRespO = p.get("scope_responsibility").toString().trim();
				if(sRespO != "")
				{
					dM.put("Scope_Responsibility",sRespO);
				}
			}
			if(ft == "requested")
			{
				dM.put("NEXT_ACTION1","Approve/Reject Fast Track");
			}
			else
			{
				dM.put("NEXT_ACTION1","Send for Research");
			}
			// Their brand online (10 Sep). The staff form now derives the same
			// search layers and client-owned exclusions the client wizard does,
			// and the journey forwards them here. Before this, a staff-placed
			// audit carried no layers and no exclusions at all -- so the
			// client's own domain, socials and shops could be reported back to
			// them as conflicts.
			if(p.get("search_layers") != null)
			{
				lyrS = List();
				lst_ls = p.get("search_layers").toList();
				for each ls in lst_ls
				{
					lyrS.add(ls.toString());
				}
				if(lyrS.size() > 0)
				{
					dM.put("Audit_Search_Layers",lyrS);
				}
			}
			// trigger workflow explicitly: Zoho suppresses workflow rules on updates made
			// from Deluge unless asked (proven 13 Sep 2026 -- the Send for Research
			// webhook fired from the API/UI but not from this function).
			trigMap = Map();
			trigMap.put("trigger",{"workflow"});
			upd = zoho.crm.updateRecord("Deals",dealId.toLong(),dM,trigMap);
			if(upd.get("id") != null)
			{
				res.put("deal_updated",true);
			}
			// Same records the 'scope' stage writes, so a staff order and a
			// self-serve order are indistinguishable downstream.
			if(p.get("exclusions") != null)
			{
				lst_x2 = p.get("exclusions").toList();
				for each x2 in lst_x2
				{
					x2m = x2.toMap();
					v2 = "";
					if(x2m.get("value") != null)
					{
						v2 = x2m.get("value").toString().trim();
					}
					if(v2 != "")
					{
						xM2 = Map();
						xM2.put("Name",v2);
						xM2.put("Exclusion_Value",v2);
						xM2.put("Target_Type",x2m.get("type").toString());
						mm2 = "Exact";
						if(x2m.get("match_mode") != null)
						{
							mm2 = x2m.get("match_mode").toString();
						}
						xM2.put("Match_Mode",mm2);
						xM2.put("Reason","Client-Owned");
						xM2.put("Active",true);
						xM2.put("Source_Type","Client-Auto-Promoted");
						if(acc2Id != "")
						{
							xM2.put("Account",acc2Id);
						}
						xM2.put("Exclusion_Notes","Declared on the staff audit form, deal " + dealId);
						zoho.crm.createRecord("Client_Search_Exclusions",xM2);
					}
				}
			}
			// Point 10 (9 Sep): structured billing address onto the Account.
			if((acc2Id != "") && (p.get("billing_addr1") != null))
			{
				aM2 = Map();
				aM2.put("Billing_Street",p.get("billing_addr1").toString());
				if(p.get("billing_city") != null)
				{
					aM2.put("Billing_City",p.get("billing_city").toString());
				}
				if(p.get("billing_region") != null)
				{
					aM2.put("Billing_State",p.get("billing_region").toString());
				}
				if(p.get("billing_postcode") != null)
				{
					aM2.put("Billing_Code",p.get("billing_postcode").toString());
				}
				if(p.get("billing_country") != null)
				{
					aM2.put("Billing_Country",p.get("billing_country").toString());
				}
				if(p.get("company_number") != null)
				{
					cnum = p.get("company_number").toString();
					if(cnum != "")
					{
						aM2.put("Company_Number1",cnum);
					}
				}
				zoho.crm.updateRecord("Accounts",acc2Id.toLong(),aM2);
			}
			// Point 3 (9 Sep): the discovery answers -- deadline, risk,
			// territories, invoice contact -- land as a Note on the Deal.
			if(p.get("discovery_note") != null)
			{
				dnM = Map();
				dnM.put("Note_Title","Sales discovery");
				dnM.put("Note_Content",p.get("discovery_note").toString());
				dnM.put("Parent_Id",dealId);
				dnM.put("$se_module","Deals");
				zoho.crm.createRecord("Notes",dnM);
			}
			// Paid orders that PASSED the validation gate get the research task.
			// A held order (Set Up Order) already has its own task listing what
			// is missing -- two tasks would contradict each other (13 Sep 2026).
			if((kind == "paid") && (missing.size() == 0))
			{
				dn = "this audit";
				if(dealRec.get("Deal_Name") != null)
				{
					dn = dealRec.get("Deal_Name").toString();
				}
				tM = Map();
				tM.put("Subject","Send for Research -- " + dn);
				tM.put("Status","Not Started");
				tM.put("Priority","High");
				tM.put("Due_Date",zoho.currentdate);
				tM.put("What_Id",dealId);
				tM.put("$se_module","Deals");
				tM.put("Owner",ownerId);
				tM.put("Description","Audit paid (server-confirmed by Stripe)." + nl + "Deal: " + dn + nl + "Invoice: " + ifnull(p.get("invoice_number"),""));
				zoho.crm.createRecord("Tasks",tM);
			}
			// Fast-track approval request to the admin team: two links, one
			// click each. Links go to the engine, which verifies the
			// signature and relays the decision back through the journey.
			if(ft == "requested")
			{
				au = "";
				ru = "";
				if(p.get("approve_url") != null)
				{
					au = p.get("approve_url").toString();
				}
				if(p.get("reject_url") != null)
				{
					ru = p.get("reject_url").toString();
				}
				dn2 = "this audit";
				if(dealRec.get("Deal_Name") != null)
				{
					dn2 = dealRec.get("Deal_Name").toString();
				}
				sendmail
				[
					from :zoho.loginuserid
					to :"support@thetrademarkhelpline.com"
					subject :"Fast Track requested -- " + dn2
					message :"<p>A client has asked to Fast Track their audit consultation.</p><p><b>Deal:</b> " + dn2 + "<br><b>Invoice:</b> " + ifnull(p.get("invoice_number"),"") + "<br><b>Client:</b> " + emIn + "</p><p>A fast track needs one clear half-day block (9am-1pm or 1pm-5pm) to prepare the audit before the consultation.</p><p><a href='" + au + "' style='background:#1F8A5B;color:#fff;padding:10px 22px;border-radius:8px;text-decoration:none;font-weight:bold'>Approve fast track</a>&nbsp;&nbsp;<a href='" + ru + "' style='background:#C0392B;color:#fff;padding:10px 22px;border-radius:8px;text-decoration:none;font-weight:bold'>Reject fast track</a></p><p><a href='https://crm.zoho.com/crm/org628887698/tab/Potentials/" + dealId + "'>Open the deal in Zoho</a></p>"
				]
			}
		}
		res.put("ok",true);
	}
	else if(stg == "fast_track_decision")
	{
		//
		// ------------------------------------- stage: fast_track_decision
		//
		// One click from the approval email (via engine signature check +
		// journey relay). Sends the client their answer -- Jonathan's copy
		// verbatim (8 Sep) -- signed Laura Spencer, reply-to support@, and
		// clears the Deal's fast-track action.
		act = "";
		if(p.get("action") != null)
		{
			act = p.get("action").toString();
		}
		cEm = "";
		if(p.get("client_email") != null)
		{
			cEm = p.get("client_email").toString();
		}
		cFn = "";
		if(p.get("client_first") != null)
		{
			cFn = p.get("client_first").toString();
		}
		greet = "Hi";
		if(cFn != "")
		{
			greet = "Hi " + cFn;
		}
		if(dealId != "")
		{
			dM = Map();
			dM.put("NEXT_ACTION1","Send for Research");
			if((act == "approve") && (p.get("date") != null))
			{
				dM.put("Deadline",p.get("date").toString().toDate());
			}
			zoho.crm.updateRecord("Deals",dealId.toLong(),dM);
			nM = Map();
			nM.put("Note_Title","Fast Track " + act);
			nM.put("Note_Content","Fast track " + act + "d" + ifnull(p.get("date"),"") + " " + ifnull(p.get("time"),"") + " -- decision relayed by the engine, emailed to " + cEm + ".");
			nM.put("Parent_Id",dealId);
			nM.put("$se_module","Deals");
			zoho.crm.createRecord("Notes",nM);
		}
		if((cEm != "") && (act == "approve"))
		{
			sendmail
			[
				from :zoho.loginuserid
				to :cEm
				subject :"Your Fast Track request -- confirmed"
				message :"<p>" + greet + ",</p><p>Thank you for your recent request to Fast Track your Audit, I am happy to confirm we can accommodate your request and we look forward to speaking with you on <b>" + ifnull(p.get("date"),"") + "</b> at <b>" + ifnull(p.get("time"),"") + "</b>.</p><p>If you have any questions in the meantime, please don't hesitate to reach out.</p><p>Kind regards,<br>Laura Spencer<br>The Trademark Helpline<br>0161 833 5400</p>"
			]
		}
		if((cEm != "") && (act == "reject"))
		{
			sendmail
			[
				from :zoho.loginuserid
				to :cEm
				subject :"Your Fast Track request"
				message :"<p>" + greet + ",</p><p>Thank you for your recent request to Fast Track your Audit, unfortunately due to high demand we can not accommodate your request on this occasion. However, your audit has been requested as a priority and one of our team will be in touch with you as soon as your audit is prepared, we estimate no more than 1 working day.</p><p>If you have any questions please do not hesitate to reach out.</p><p>Kind regards,<br>Laura Spencer<br>The Trademark Helpline<br>0161 833 5400</p>"
			]
		}
		res.put("ok",true);
	}
	else if(stg == "load")
	{
		//
		// --------------------------------------------------- stage: load
		//
		// Read-back for EDIT mode. Shared by BOTH staff forms -- Audit Fact
		// Find (/staff-enquiry, sales) and Quick Audit (/quick-audit,
		// Jonathan + admin). Added 15 Sep 2026.
		//
		// Why this stage exists. Every write stage here was ALREADY
		// idempotent on zoho_deal_id -- contact, scope, summary, paid and
		// order_complete all test dealId != "" and update rather than
		// create. The gap was the other direction: nothing could read an
		// audit back out, so opening an existing Deal gave a blank form and
		// staff retyped what was already on the record. This closes that.
		//
		// READ ONLY. It creates nothing and updates nothing. Two guards make
		// edit mode safe and NEITHER is decided here:
		//
		//   1. The caller must not create Lead/Contact/Account in edit mode.
		//      Same rule as the Deal-scoped class builder (21 Aug): those
		//      records already exist, and re-running the resolver against an
		//      edit is how you get duplicates.
		//   2. 'frozen' below reports whether Braudit_Frozen_At is stamped.
		//      Past freeze the criteria are immutable -- a change generates a
		//      NEW search_context_id, which is the contract's 409 case. The
		//      form must block the edit or make the re-freeze explicit. We
		//      report the fact; the form owns the decision.
		//
		// Exclusions are fetched from BOTH scopes deliberately, because they
		// mean different things (see CLAUDE.md, EXCLUSIONS SCHEMA):
		//   * deal-scoped   -> Deal_Override, a one-off "not a concern"
		//   * account-scoped -> standing portfolio items on the APPLICANT
		// An edit screen that showed only one of them would invite staff to
		// re-add an exclusion that already exists at the other scope.
		if(dealId == "")
		{
			res.put("ok",false);
			res.put("error","deal id required");
			return res.toString();
		}
		dR = zoho.crm.getRecordById("Deals",dealId.toLong());
		if(dR == null)
		{
			res.put("ok",false);
			res.put("error","deal not found");
			return res.toString();
		}
		dM2 = Map();
		flds = {"Deal_Name","Stage","Next_Action","Applicant_Match_Status","Applicant_Candidates","Audit_Payment_Method","Audit_Order_Ref","Audit_Deadline","Braudit_Trigger_Status","Braudit_Frozen_At","Logo_Awaited","Audit_Search_Layers","Trademark_Jurisdictions","Braudit_Search_Types","Lead_Source_Group","Amount"};
		for each  fn in flds
		{
			dM2.put(fn,ifnull(dR.get(fn),""));
		}
		// for each over a literal range, NOT while: Deluge in this org rejects
		// `while` outright (save fails with "syntax is incorrect"). The rest of
		// this function uses `for each` 30 times and `while` zero times --
		// that ratio was the clue.
		slots = {1,2,3,4,5};
		for each  i in slots
		{
			dM2.put("Search_Word_" + i,ifnull(dR.get("Search_Word_" + i),""));
			dM2.put("Search_Operator_" + i,ifnull(dR.get("Search_Operator_" + i),""));
			dM2.put("Search_Domain_" + i,ifnull(dR.get("Search_Domain_" + i),""));
			dM2.put("Domain_Search_Operator_" + i,ifnull(dR.get("Domain_Search_Operator_" + i),""));
		}
		// Billing account and APPLICANT account are different things and the
		// form must not conflate them. On a reseller deal Account_Name is the
		// PARTNER; the Deal_Applicant_Accounts rows are the clients the audit
		// is actually for.
		accL = dR.get("Account_Name");
		if(accL != null)
		{
			dM2.put("account_id",ifnull(accL.get("id"),"").toString());
			dM2.put("account_name",ifnull(accL.get("name"),""));
		}
		// The person on the order (16 Sep): edit mode needs the contact to
		// pass its own G-00 without retyping -- and must NEVER create one.
		cL2 = dR.get("Contact_Name");
		if(cL2 != null)
		{
			cid2 = ifnull(cL2.get("id"),"").toString();
			dM2.put("contact_id",cid2);
			dM2.put("contact_name",ifnull(cL2.get("name"),""));
			if(cid2 != "")
			{
				cR2 = zoho.crm.getRecordById("Contacts",cid2.toLong());
				if(cR2 != null)
				{
					dM2.put("contact_first",ifnull(cR2.get("First_Name"),""));
					dM2.put("contact_last",ifnull(cR2.get("Last_Name"),""));
					dM2.put("contact_email",ifnull(cR2.get("Email"),""));
					dM2.put("contact_phone",ifnull(cR2.get("Phone"),""));
					dM2.put("contact_title",ifnull(cR2.get("Title"),""));
				}
			}
		}
		// Applicants come from the Deal_Applicant_Accounts junction (16 Sep),
		// never from Applicant_1 -- that field is retired because a mark can
		// have any number of applicants. appIds feeds the account-scoped
		// exclusions below, one search per applicant account.
		applicants = List();
		appIds = List();
		appRows = zoho.crm.getRelatedRecords("Deal_Applicant_Accounts","Deals",dealId.toLong());
		if(appRows != null)
		{
			for each  apr in appRows
			{
				apA = apr.get("Applicant_Account");
				if(apA != null)
				{
					apM = Map();
					apM.put("link_id",apr.get("id").toString());
					apM.put("account_id",ifnull(apA.get("id"),"").toString());
					apM.put("account_name",ifnull(apA.get("name"),""));
					apM.put("role",ifnull(apr.get("Role"),""));
					apM.put("source_type",ifnull(apr.get("Source_Type"),""));
					applicants.add(apM);
					appIds.add(ifnull(apA.get("id"),"").toString());
				}
			}
		}
		dM2.put("frozen",dR.get("Braudit_Frozen_At") != null);
		res.put("deal",dM2);
		res.put("applicants",applicants);
		// Images + Vienna live on the Image_Mark_Information subform, per
		// Jonathan's 12 Sep decision. Image_Assets is the eventual home but
		// is empty and has no Deal link.
		imgs = List();
		if(dR.get("Image_Mark_Information") != null)
		{
			// Assign to a variable first. Deluge rejects a method call in the
			// `for each ... in` clause -- the save fails pointing at the loop's
			// opening brace, exactly like `while` does. Every existing loop in
			// this function assigns first (see lst_t in the factfind stage).
			imgRows = dR.get("Image_Mark_Information").toList();
			for each  ir in imgRows
			{
				iM = Map();
				iM.put("nickname",ifnull(ir.get("Image_Nickname"),""));
				iM.put("vienna",ifnull(ir.get("Vienna_Codes"),""));
				iM.put("division",ifnull(ir.get("Post_S_Img_Class_Div_Sub_Div"),""));
				imgs.add(iM);
			}
		}
		res.put("images",imgs);
		// Frozen scope: the asset rows plus their class/term children.
		scopes = List();
		relS = zoho.crm.getRelatedRecords("G_S_Scope_Assets","Deals",dealId.toLong());
		if(relS != null)
		{
			for each  sa in relS
			{
				sM = Map();
				saId = sa.get("id").toString();
				sM.put("id",saId);
				sM.put("status",ifnull(sa.get("Asset_Status"),""));
				sM.put("register",ifnull(sa.get("Register"),""));
				terms = List();
				srchT = zoho.crm.getRelatedRecords("G_S_Scope_Classes_Terms","G_S_Scope_Assets",saId.toLong());
				if(srchT != null)
				{
					for each  tr in srchT
					{
						tM = Map();
						tM.put("class_no",ifnull(tr.get("Nice_Class_Number_Snapshot"),""));
						tM.put("description",ifnull(tr.get("Class_Description_Snapshot"),""));
						tM.put("terms",ifnull(tr.get("Specific_Terms"),""));
						tM.put("source",ifnull(tr.get("Terms_Source"),""));
						terms.add(tM);
					}
				}
				sM.put("terms",terms);
				scopes.add(sM);
			}
		}
		res.put("scope",scopes);
		exs = List();
		relX = zoho.crm.getRelatedRecords("Client_Search_Exclusions","Deals",dealId.toLong());
		if(relX != null)
		{
			for each  xr in relX
			{
				xM = Map();
				xM.put("id",xr.get("id").toString());
				xM.put("value",ifnull(xr.get("Exclusion_Value"),""));
				xM.put("target_type",ifnull(xr.get("Target_Type"),""));
				xM.put("reason",ifnull(xr.get("Reason"),""));
				xM.put("match_mode",ifnull(xr.get("Match_Mode"),""));
				xM.put("active",ifnull(xr.get("Active"),false));
				xM.put("scope","deal");
				exs.add(xM);
			}
		}
		for each  appId in appIds
		{
			srchX = zoho.crm.searchRecords("Client_Search_Exclusions","(Account:equals:" + appId + ")");
			if(srchX != null)
			{
				for each  ar in srchX
				{
					if(exs.size() < 200)
					{
						aX = Map();
						aX.put("id",ar.get("id").toString());
						aX.put("value",ifnull(ar.get("Exclusion_Value"),""));
						aX.put("target_type",ifnull(ar.get("Target_Type"),""));
						aX.put("reason",ifnull(ar.get("Reason"),""));
						aX.put("match_mode",ifnull(ar.get("Match_Mode"),""));
						aX.put("active",ifnull(ar.get("Active"),false));
						aX.put("scope","account");
						exs.add(aX);
					}
				}
			}
		}
		res.put("exclusions",exs);
		res.put("ok",true);
	}
	else if(stg == "applicant_link")
	{
		//
		// ------------------------------------------ stage: applicant_link
		//
		// Resolve WHO THE AUDIT IS FOR and link them to the Deal via the
		// Deal_Applicant_Accounts junction (16 Sep 2026, Jonathan). Called by
		// both staff forms and the client checkout once a Deal exists.
		//
		// Billing and applicant are different questions. The 'applicant'
		// stage above resolves the BILLER into Account_Name; on a reseller or
		// white-label deal that is the partner, not the client. This stage
		// resolves the client, and it is the only writer of the junction.
		//
		// Inputs
		//   zoho_deal_id                 required
		//   applicant_same_as_billing    "true" -> link the Deal's Account_Name
		//   applicant_name / applicant_company_number / applicant_identifier
		//   source_type                  Staff | Client-Auto-Promoted
		//
		// Confidence rules (Jonathan, 12 Sep): company number and IPO
		// applicant id are the only keys safe to act on alone. A name match
		// is a CANDIDATE for a human, never an automatic link. An Account is
		// CREATED only after a strong key was searched and found nothing --
		// never from a name. Everything else queues for Laura as a Task.
		//
		// Guard: never creates a Lead or Contact. Never links Applicant_1.
		if(dealId == "")
		{
			res.put("ok",false);
			res.put("error","deal id required");
			return res.toString();
		}
		dR = zoho.crm.getRecordById("Deals",dealId.toLong());
		if(dR == null)
		{
			res.put("ok",false);
			res.put("error","deal not found");
			return res.toString();
		}
		dealNm = ifnull(dR.get("Deal_Name"),"");
		srcT = "Staff";
		if((p.get("source_type") != null) && (p.get("source_type").toString() == "Client-Auto-Promoted"))
		{
			srcT = "Client-Auto-Promoted";
		}
		sameAsBill = false;
		if(p.get("applicant_same_as_billing") != null)
		{
			sameAsBill = p.get("applicant_same_as_billing").toString().equalsIgnoreCase("true");
		}
		apName = "";
		if(p.get("applicant_name") != null)
		{
			apName = p.get("applicant_name").toString().trim();
		}
		apNum = "";
		if(p.get("applicant_company_number") != null)
		{
			apNum = p.get("applicant_company_number").toString().trim();
		}
		apAid = "";
		if(p.get("applicant_identifier") != null)
		{
			apAid = p.get("applicant_identifier").toString().trim();
		}
		matchedId = "";
		matchedNm = "";
		astatus = "";
		cands = List();
		// 1. Same as the biller -- but never a partner. If the billing account
		//    carries a Partner_Type it is a reseller/introducer/white label and
		//    cannot be the applicant by definition; that goes to review.
		if(sameAsBill)
		{
			bL = dR.get("Account_Name");
			if(bL != null)
			{
				bId = ifnull(bL.get("id"),"").toString();
				if(bId != "")
				{
					bR = zoho.crm.getRecordById("Accounts",bId.toLong());
					ptype = "";
					if(bR.get("Partner_Type") != null)
					{
						ptype = bR.get("Partner_Type").toString();
					}
					if(ptype != "")
					{
						astatus = "Needs review";
						cands.add(ifnull(bL.get("name"),"") + " (" + bId + ") is the biller but is a " + ptype + " partner, so cannot be the applicant");
					}
					else
					{
						matchedId = bId;
						matchedNm = ifnull(bL.get("name"),"");
						astatus = "Matched";
					}
				}
			}
		}
		// 2. Strong keys: company number (Company_URN, text, keeps SC/NI
		//    prefixes) then the IPO applicant id. One hit on either is a match.
		if((matchedId == "") && (astatus == "") && (apNum != ""))
		{
			fa = zoho.crm.searchRecords("Accounts","(Company_URN:equals:" + apNum + ")");
			if((fa != null) && (fa.size() > 0))
			{
				fa0 = fa.get(0);
				matchedId = fa0.get("id").toString();
				matchedNm = ifnull(fa0.get("Account_Name"),"");
				astatus = "Matched";
			}
		}
		if((matchedId == "") && (astatus == "") && (apAid != ""))
		{
			fb = zoho.crm.searchRecords("Accounts","(Applicant_identifier:equals:" + apAid + ")");
			if((fb != null) && (fb.size() > 0))
			{
				fb0 = fb.get(0);
				matchedId = fb0.get("id").toString();
				matchedNm = ifnull(fb0.get("Account_Name"),"");
				astatus = "Matched";
			}
		}
		// 3. Name only -> candidates for a human, never a link. 14,404 accounts
		//    with inconsistent naming; an automatic name match would create
		//    duplicates or merge the wrong two.
		if((matchedId == "") && (astatus == "") && (apName != ""))
		{
			fc = zoho.crm.searchRecords("Accounts","(Account_Name:equals:" + apName + ")");
			if((fc != null) && (fc.size() > 0))
			{
				for each  cr in fc
				{
					if(cands.size() < 6)
					{
						cands.add(ifnull(cr.get("Account_Name"),"") + " (" + cr.get("id").toString() + ") - exact name match, no company number or applicant id to confirm");
					}
				}
				astatus = "Needs review";
			}
		}
		// 4. Nothing matched. Create ONLY if a strong key was searched and
		//    found nothing; a bare name is not enough to invent an Account.
		if((matchedId == "") && (astatus == ""))
		{
			if((apNum != "") || (apAid != ""))
			{
				nA = Map();
				nA.put("Account_Name",apName);
				nA.put("Applicant_name",apName);
				if(apNum != "")
				{
					nA.put("Company_URN",apNum);
					nA.put("Applicant_company_number",apNum);
				}
				if(apAid != "")
				{
					nA.put("Applicant_identifier",apAid.toLong());
				}
				at2 = List();
				at2.add("Trademark Applicant");
				nA.put("Account_Type_2",at2);
				nr = zoho.crm.createRecord("Accounts",nA);
				if(nr.get("id") != null)
				{
					matchedId = nr.get("id").toString();
					matchedNm = apName;
					astatus = "Created";
				}
			}
			else if(apName != "")
			{
				astatus = "Needs review";
				cands.add(apName + " - name only; no company number or applicant id, nothing found to match");
			}
			else
			{
				astatus = "No applicant supplied";
			}
		}
		// 5. Link. Make sure the account is typed as an applicant, then write
		//    the junction row unless one already exists for this pair.
		if(matchedId != "")
		{
			aR2 = zoho.crm.getRecordById("Accounts",matchedId.toLong());
			typs2 = List();
			if(aR2.get("Account_Type_2") != null)
			{
				lst_t2 = aR2.get("Account_Type_2").toList();
				for each  t2 in lst_t2
				{
					typs2.add(t2.toString());
				}
			}
			if(typs2.contains("Trademark Applicant") == false)
			{
				typs2.add("Trademark Applicant");
				aU2 = Map();
				aU2.put("Account_Type_2",typs2);
				zoho.crm.updateRecord("Accounts",matchedId.toLong(),aU2);
			}
			// Dedupe via the RELATED LIST, not searchRecords. Search is index-
			// backed and lags on records created seconds earlier -- proven
			// 16 Sep: two identical rows from two calls 30s apart, because the
			// second call's search could not yet see the first row. The
			// related-list read is direct and does not lag.
			already = false;
			relJ = zoho.crm.getRelatedRecords("Deal_Applicant_Accounts","Deals",dealId.toLong());
			if(relJ != null)
			{
				for each  jr in relJ
				{
					jA = jr.get("Applicant_Account");
					if(jA != null)
					{
						if(ifnull(jA.get("id"),"").toString() == matchedId)
						{
							already = true;
						}
					}
				}
			}
			if(already == false)
			{
				jN = dealNm + " - " + matchedNm;
				if(jN.length() > 120)
				{
					jN = jN.subString(0,120);
				}
				jM = Map();
				jM.put("Name",jN);
				jM.put("Deal",dealId.toLong());
				jM.put("Applicant_Account",matchedId.toLong());
				jM.put("Role","Applicant");
				jM.put("Source_Type",srcT);
				zoho.crm.createRecord("Deal_Applicant_Accounts",jM);
			}
		}
		// 6. Record the outcome on the Deal. Needs review / No applicant
		//    supplied leave NO junction row, which is what the research gate
		//    in order_complete tests.
		dU = Map();
		dU.put("Applicant_Match_Status",astatus);
		if(cands.size() > 0)
		{
			dU.put("Applicant_Candidates",cands.toString(nl));
		}
		else
		{
			dU.put("Applicant_Candidates","");
		}
		zoho.crm.updateRecord("Deals",dealId.toLong(),dU);
		// 7. Queue for Laura. A Task, not an email -- the org API key still
		//    sends as a departed user (open ticket).
		if((astatus == "Needs review") || (astatus == "No applicant supplied"))
		{
			tQ = Map();
			tQ.put("Subject","Confirm applicant account -- " + dealNm);
			tQ.put("Description","Applicant Match Status: " + astatus + nl + "Candidates:" + nl + cands.toString(nl) + nl + nl + "Open the Deal, add the correct Account under Deal Applicant Accounts, then set Next Action Sub Status to 'Send for Research'.");
			tQ.put("Status","Not Started");
			tQ.put("Priority","High");
			tQ.put("Due_Date",zoho.currentdate);
			tQ.put("What_Id",dealId);
			tQ.put("$se_module","Deals");
			tQ.put("Owner","1964745000036444001");
			zoho.crm.createRecord("Tasks",tQ);
		}
		res.put("ok",true);
		res.put("status",astatus);
		res.put("applicant_account_id",matchedId);
		res.put("candidates",cands);
	}
	else if(stg == "staff_lookup")
	{
		//
		// -------------------------------------------- stage: staff_lookup
		//
		// Typed lookups for the staff order form (9 Sep): Contacts, Leads or
		// Accounts by name or email, six candidates max. Read-only.
		modIn = "";
		if(p.get("module") != null)
		{
			modIn = p.get("module").toString();
		}
		qIn = "";
		if(p.get("q") != null)
		{
			qIn = p.get("q").toString().trim();
		}
		hits = List();
		if((qIn != "") && (modIn == "Accounts"))
		{
			srchA = zoho.crm.searchRecords("Accounts","(Account_Name:starts_with:" + qIn + ")");
			for each  arow in srchA
			{
				if(hits.size() < 6)
				{
					hM = Map();
					hM.put("id",arow.get("id").toString());
					hM.put("name",ifnull(arow.get("Account_Name"),""));
					hits.add(hM);
				}
			}
		}
		else if((qIn != "") && ((modIn == "Contacts") || (modIn == "Leads")))
		{
			crit = "((Last_Name:starts_with:" + qIn + ")or(First_Name:starts_with:" + qIn + "))";
			if(qIn.contains("@"))
			{
				qPre = qIn;
				if(qIn.contains("+"))
				{
					qPre = qIn.getPrefix("+");
				}
				crit = "(Email:starts_with:" + qPre + ")";
			}
			srchP = zoho.crm.searchRecords(modIn,crit);
			for each  prow in srchP
			{
				if(hits.size() < 6)
				{
					hM = Map();
					hM.put("id",prow.get("id").toString());
					nm = ifnull(prow.get("Full_Name"),"");
					if(nm == "")
					{
						nm = ifnull(prow.get("First_Name"),"") + " " + ifnull(prow.get("Last_Name"),"");
					}
					hM.put("name",nm.trim());
					hM.put("first",ifnull(prow.get("First_Name"),""));
					hM.put("last",ifnull(prow.get("Last_Name"),""));
					hM.put("email",ifnull(prow.get("Email"),""));
					if(modIn == "Contacts")
					{
						if(prow.get("Account_Name") != null)
						{
							hM.put("account",ifnull(prow.get("Account_Name").get("name"),""));
							hM.put("account_id",ifnull(prow.get("Account_Name").get("id"),""));
						}
					}
					else
					{
						hM.put("detail",ifnull(prow.get("Company"),""));
					}
					hits.add(hM);
				}
			}
		}
		// Contacts OF an Account (11 Sep). Anchoring an audit on the Account is
		// what brings the client's portfolio and their existing Client-Owned
		// exclusions into the call -- but the audit still belongs to a person,
		// so once the Account is chosen staff pick the contact from it.
		if(modIn == "AccountContacts")
		{
			accQ = "";
			if(p.get("account_id") != null)
			{
				accQ = p.get("account_id").toString().trim();
			}
			if(accQ != "")
			{
				rel = zoho.crm.getRelatedRecords("Contacts","Accounts",accQ.toLong());
				for each  crow in rel
				{
					if(hits.size() < 25)
					{
						cM = Map();
						cM.put("id",crow.get("id").toString());
						cn2 = ifnull(crow.get("Full_Name"),"");
						if(cn2 == "")
						{
							cn2 = ifnull(crow.get("First_Name"),"") + " " + ifnull(crow.get("Last_Name"),"");
						}
						cM.put("name",cn2.trim());
						cM.put("first",ifnull(crow.get("First_Name"),""));
						cM.put("last",ifnull(crow.get("Last_Name"),""));
						cM.put("email",ifnull(crow.get("Email"),""));
						cM.put("phone",ifnull(crow.get("Phone"),""));
						cM.put("mobile",ifnull(crow.get("Mobile"),""));
						cM.put("detail",ifnull(crow.get("Title"),""));
						hits.add(cM);
					}
				}
			}
		}
		res.put("hits",hits);
		res.put("ok",true);
	}
	else if((stg == "ai_block") && (emIn != ""))
	{
		//
		// ----------------------------------------------- stage: ai_block
		//
		// Fair-use on the AI class tools is exhausted for this email. Flag the
		// Lead and/or Contact so staff can see who is hitting the limit and
		// have the conversation. Cleared by a human unticking the box -- never
		// automatically (Jonathan, 28 Aug).
		blk = Map();
		blk.put("AI_Tools_Blocked",true);
		// Clearing the reset stamp is what makes unblocking meaningful: the
		// next use after staff untick the box re-stamps it (see ai_safe), so
		// counting starts again from that moment and the person gets a fresh
		// allowance -- the app simply treats them as new (Jonathan, 30 Aug).
		blk.put("AI_Allowance_Reset",null);
		fndL = zoho.crm.searchRecords("Leads","(Email:starts_with:" + emPre + ")");
		hitBL = fndL.toString();
		if(hitBL.contains("id"))
		{
			for each  lrow in fndL
			{
				if(lrow.get("Email") != null)
				{
					if(lrow.get("Email").toString().equalsIgnoreCase(emIn))
					{
						zoho.crm.updateRecord("Leads",lrow.get("id").toString().toLong(),blk);
						res.put("lead_flagged",lrow.get("id").toString());
					}
				}
			}
		}
		fndC2 = zoho.crm.searchRecords("Contacts","(Email:starts_with:" + emPre + ")");
		hitBC = fndC2.toString();
		if(hitBC.contains("id"))
		{
			for each  crow in fndC2
			{
				if(crow.get("Email") != null)
				{
					if(crow.get("Email").toString().equalsIgnoreCase(emIn))
					{
						zoho.crm.updateRecord("Contacts",crow.get("id").toString().toLong(),blk);
						res.put("contact_flagged",crow.get("id").toString());
					}
				}
			}
		}
		res.put("ok",true);
	}
	else if((stg == "ai_safe") && (emIn != ""))
	{
		//
		// ----------------------------------------------- stage: ai_safe
		//
		// Safe Email list (Jonathan, 28 Aug): is this email exempt from the
		// AI fair-use allowance? True when the Lead OR Contact carries
		// AI Safe Sender -- ticked by staff for introducers, resellers and
		// trusted partners. The journey function asks BEFORE counting a use,
		// so a safe sender is never limited, never blocked, never flagged.
		safe = false;
		blocked = false;
		// The clock comes from the caller, not from here. zoho.currenttime in a
		// standalone function reported 05:18 on the 31st while the real time was
		// 21:18 on the 30th (proven 30 Aug), and a reset stamped in the FUTURE
		// silently grants an unlimited allowance, because no use is ever after
		// it. The journey sends its own ISO timestamp instead.
		nowIn = "";
		if(p.get("now") != null)
		{
			nowIn = p.get("now").toString();
		}
		resetRaw = "";
		justReset = false;
		hitId = "";
		hitMod = "";
		sfL = zoho.crm.searchRecords("Leads","(Email:starts_with:" + emPre + ")");
		hitSL = sfL.toString();
		if(hitSL.contains("id"))
		{
			for each  srow in sfL
			{
				if(srow.get("Email") != null)
				{
					if(srow.get("Email").toString().equalsIgnoreCase(emIn))
					{
						hitId = srow.get("id").toString();
						hitMod = "Leads";
						if(srow.get("AI_Safe_Sender") != null)
						{
							if(srow.get("AI_Safe_Sender").toString().equalsIgnoreCase("true"))
							{
								safe = true;
							}
						}
						if(srow.get("AI_Tools_Blocked") != null)
						{
							if(srow.get("AI_Tools_Blocked").toString().equalsIgnoreCase("true"))
							{
								blocked = true;
							}
						}
						if(srow.get("AI_Allowance_Reset") != null)
						{
							resetRaw = srow.get("AI_Allowance_Reset").toString();
						}
					}
				}
			}
		}
		sfC = zoho.crm.searchRecords("Contacts","(Email:starts_with:" + emPre + ")");
		hitSC = sfC.toString();
		if(hitSC.contains("id"))
		{
			for each  scrow in sfC
			{
				if(scrow.get("Email") != null)
				{
					if(scrow.get("Email").toString().equalsIgnoreCase(emIn))
					{
						hitId = scrow.get("id").toString();
						hitMod = "Contacts";
						if(scrow.get("AI_Safe_Sender") != null)
						{
							if(scrow.get("AI_Safe_Sender").toString().equalsIgnoreCase("true"))
							{
								safe = true;
							}
						}
						if(scrow.get("AI_Tools_Blocked") != null)
						{
							if(scrow.get("AI_Tools_Blocked").toString().equalsIgnoreCase("true"))
							{
								blocked = true;
							}
						}
						if(scrow.get("AI_Allowance_Reset") != null)
						{
							resetRaw = scrow.get("AI_Allowance_Reset").toString();
						}
					}
				}
			}
		}
		// Not blocked and no reset stamp yet -> this is either a brand-new
		// email or one an adviser has just unblocked. Stamp it now; the app
		// counts only uses AFTER this moment, which is what "treat them as
		// new" means in practice.
		if((blocked == false) && (resetRaw == ""))
		{
			if(hitId != "")
			{
				stampM = Map();
				// A datetime field wants an ISO-8601 string with an offset; the
				// bare zoho.currenttime object writes nothing and reports no
				// error (proven 30 Aug -- the field stayed null while the stage
				// kept claiming it had stamped, which handed out an endless
				// allowance). The write is verified before it is believed.
				if(nowIn != "")
				{
					stampM.put("AI_Allowance_Reset",nowIn);
				}
				else
				{
					stampM.put("AI_Allowance_Reset",zoho.currenttime);
				}
				upd = zoho.crm.updateRecord(hitMod,hitId.toLong(),stampM);
				if(upd.get("id") != null)
				{
					justReset = true;
				}
			}
		}
		res.put("safe",safe);
		res.put("blocked",blocked);
		res.put("reset",resetRaw);
		res.put("just_reset",justReset);
		res.put("ok",true);
	}
	else if(stg == "factfind")
	{
		//
		// ----------------------------------------------- stage: factfind
		//
		// The closing questions. Account Types -> Accounts, Review Type ->
		// Client Relationships, motivation + free text -> the Deal.
		if(dealId != "")
		{
			dM = Map();
			if(p.get("primary_motivation") != null)
			{
				dM.put("Main_Reason",p.get("primary_motivation").toString());
			}
			if(p.get("enquiry_notes") != null)
			{
				dM.put("What_prompted_Trademark_App_or_Enquiry",p.get("enquiry_notes").toString());
			}
			if(dM.size() > 0)
			{
				zoho.crm.updateRecord("Deals",dealId.toLong(),dM);
			}
		}
		// 'Account Types' is Account_Type_2, a MULTI-select (Jonathan, 28 Aug).
		// The four answers collapse to the two real values; the existing
		// values on the account are preserved, never replaced.
		if(accountId != "")
		{
			ansr = p.get("account_type").toString();
			want = "Trademark Applicant";
			if(ansr.containsIgnoreCase("client I represent"))
			{
				want = "White Label Partner (Billing Account & Contact)";
			}
			accRec = zoho.crm.getRecordById("Accounts",accountId.toLong());
			typs = List();
			if(accRec.get("Account_Type_2") != null)
			{
				lst_t = accRec.get("Account_Type_2").toList();
				for each t in lst_t
				{
					typs.add(t.toString());
				}
			}
			if(typs.contains(want) == false)
			{
				typs.add(want);
				aM = Map();
				aM.put("Account_Type_2",typs);
				zoho.crm.updateRecord("Accounts",accountId.toLong(),aM);
			}
		}
		res.put("ok",true);
	}
	return res.toString();
}
