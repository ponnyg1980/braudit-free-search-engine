string standalone.tmh_brand_audit_intake(string crmAPIRequest)
{
	// Brand Audit intake -> Contacts + Accounts + one Deal per brand.
	//
	// WHY THIS EXISTS (Jonathan, 27 Aug 2026)
	// "Brand Audits will no longer go in leads, as they are a buying intent
	// and they can have multiple audits within one, they are contacts,
	// accounts and potentially multiple deals - Name, Logo & Tagline per
	// brand potentially."
	//
	// So an audit submission is NOT a lead. It is:
	//   Account  (reused if the contact already has one, else created)
	//   Contact  (matched on email, else created under that account)
	//   Deal     ONE PER BRAND, named
	//              "{variant} - {brand} {types}"
	//            e.g. "Trademark Audit Only - STREETVISION Word, Logo"
	//            variant = Trademark Audit Only | Trademark Audit & Consultation
	//            types   = what they actually gave us: Word (a name),
	//                      Logo (uploaded or promised). A tagline is NOT a
	//                      separate deal — it rides on the brand's deal for
	//                      the adviser to price (Jonathan, 27 Aug).
	//   G S Scope Asset + Classes Terms rows per brand, hung off ITS deal,
	//   and mirrored into that deal's Classes Terms sub-form (still read by
	//   live automations).
	//
	// An existing Free Search lead for the same email is CONVERTED into this
	// contact/account rather than left as a duplicate.
	//
	// Deals are created WITHOUT Free_Search_Session, so the Deals on-create
	// workflow (tmh_freesearch_on_convert) does not fire for them — this
	// function has already done the per-brand fan-out itself.
	reqMap = crmAPIRequest.toMap();
	bodyRaw = reqMap.get("body");
	if(bodyRaw == null)
	{
		return "no body";
	}
	p = bodyRaw.toString().toMap();
	nl = zoho.encryption.urlDecode("%0A");
	em = "";
	if(p.get("email") != null)
	{
		em = p.get("email").toString().trim();
	}
	if(em == "" || em.contains("@") == false)
	{
		return "no email";
	}
	first = "";
	if(p.get("first_name") != null)
	{
		first = p.get("first_name").toString().trim();
	}
	last = "";
	if(p.get("last_name") != null)
	{
		last = p.get("last_name").toString().trim();
	}
	if(last == "")
	{
		last = "Audit request";
	}
	phone = "";
	if(p.get("phone") != null)
	{
		phone = p.get("phone").toString().trim();
	}
	bizName = "";
	if(p.get("business_name") != null)
	{
		bizName = p.get("business_name").toString().trim();
	}
	bizSite = "";
	if(p.get("business_website") != null)
	{
		bizSite = p.get("business_website").toString().trim();
	}
	variant = "Trademark Audit Only";
	if(p.get("audit_variant") != null && p.get("audit_variant").toString() != "")
	{
		variant = p.get("audit_variant").toString();
	}
	accName = bizName;
	if(accName == "")
	{
		accName = (first + " " + last).trim();
	}
	// ---------- 1. Contact / Account ----------------------------------
	contactId = "";
	accountId = "";
	foundC = zoho.crm.searchRecords("Contacts","(Email:equals:" + em + ")");
	if(foundC.size() > 0)
	{
		contactId = foundC.get(0).get("id").toString();
		if(foundC.get(0).get("Account_Name") != null)
		{
			accountId = foundC.get(0).get("Account_Name").get("id").toString();
		}
	}
	// ---------- 2. Convert any existing lead (Jonathan: automatic) -----
	// Done BEFORE we create anything ourselves: if a Free Search lead is
	// sitting there, converting it produces the Contact/Account properly
	// (with Zoho's own mapping) instead of leaving a duplicate behind.
	converted = "";
	foundL = zoho.crm.searchRecords("Leads","(Email:equals:" + em + ")");
	for each ld in foundL
	{
		lid = ld.get("id").toString();
		cMap = Map();
		cMap.put("overwrite",true);
		cMap.put("notify_lead_owner",false);
		cMap.put("notify_new_entity_owner",false);
		if(contactId != "")
		{
			cMap.put("Contacts",contactId);
		}
		if(accountId != "")
		{
			cMap.put("Accounts",accountId);
		}
		cv = zoho.crm.convertLead(lid.toLong(),cMap);
		if(cv != null && cv.get("Contacts") != null)
		{
			if(contactId == "")
			{
				contactId = cv.get("Contacts").toString();
			}
			if(accountId == "" && cv.get("Accounts") != null)
			{
				accountId = cv.get("Accounts").toString();
			}
			converted = converted + ":lead=" + lid;
		}
		else
		{
			info "audit: lead convert skipped/failed " + lid + " -> " + cv;
		}
	}
	// ---------- 3. Create what conversion did not give us --------------
	if(accountId == "")
	{
		foundA = zoho.crm.searchRecords("Accounts","(Account_Name:equals:" + accName + ")");
		if(foundA.size() > 0)
		{
			accountId = foundA.get(0).get("id").toString();
		}
		else
		{
			aM = Map();
			aM.put("Account_Name",accName);
			if(bizSite != "")
			{
				aM.put("Website",bizSite);
			}
			if(phone != "")
			{
				aM.put("Phone",phone);
			}
			ac = zoho.crm.createRecord("Accounts",aM);
			if(ac.get("id") != null)
			{
				accountId = ac.get("id").toString();
			}
			else
			{
				info ac;
				return "account create failed";
			}
		}
	}
	if(contactId == "")
	{
		cM = Map();
		cM.put("Last_Name",last);
		if(first != "")
		{
			cM.put("First_Name",first);
		}
		cM.put("Email",em);
		if(phone != "")
		{
			cM.put("Phone",phone);
		}
		cM.put("Account_Name",accountId.toLong());
		cc = zoho.crm.createRecord("Contacts",cM);
		if(cc.get("id") != null)
		{
			contactId = cc.get("id").toString();
		}
		else
		{
			info cc;
			return "contact create failed";
		}
	}
	// ---------- 4. Nice class picklist labels for the sub-form ---------
	clsPick = Map();
	clsPick.put("1","1 - Chemicals");
	clsPick.put("2","2 - Colourants");
	clsPick.put("3","3 - Toiletries");
	clsPick.put("4","4 - Fuels");
	clsPick.put("5","5 - Preparations");
	clsPick.put("6","6 - Metal");
	clsPick.put("7","7 - Machinery");
	clsPick.put("8","8 - Tools");
	clsPick.put("9","9 - Scientific Devices");
	clsPick.put("10","10 - Therapeutic Devices");
	clsPick.put("11","11 - Heating Components");
	clsPick.put("12","12 - Vehicles");
	clsPick.put("13","13 - Weapons & Explosives");
	clsPick.put("14","14 - Jewellery & Precious Minerals");
	clsPick.put("15","15 - Musical Instruments");
	clsPick.put("16","16 - Artistic Materials");
	clsPick.put("17","17 - Piping & Tubing");
	clsPick.put("18","18 - Accessories & Leather");
	clsPick.put("19","19 - Construction Materials");
	clsPick.put("20","20 - Decorative Fittings & Furniture");
	clsPick.put("21","21 - Household Utensils");
	clsPick.put("22","22 - Raw Fibres");
	clsPick.put("23","23 - Yarns & Threads");
	clsPick.put("24","24 - Textiles");
	clsPick.put("25","25 - Clothing");
	clsPick.put("26","26 - Accessories Components");
	clsPick.put("27","27 - Floor & Wall Coverings");
	clsPick.put("28","28 - Sports Equipment & Toys");
	clsPick.put("29","29 - Raw and Prepared Food");
	clsPick.put("30","30 - Convenience Food");
	clsPick.put("31","31 - Agriculture & Livestock");
	clsPick.put("32","32 - Beer & Non-Alcoholic Beverages");
	clsPick.put("33","33 - Alcoholic Beverages");
	clsPick.put("34","34 - Tobacco & Lighting Articles");
	clsPick.put("35","35 - Business Services");
	clsPick.put("36","36 - Financial Services");
	clsPick.put("37","37 - Building & Construction");
	clsPick.put("38","38 - Telecoms");
	clsPick.put("39","39 - Transport");
	clsPick.put("40","40 - Various Chemical Treatment & Energy Production");
	clsPick.put("41","41 - Education");
	clsPick.put("42","42 - I.T.");
	clsPick.put("43","43 - Hospitality");
	clsPick.put("44","44 - Animal, Environmental & Human Health Care");
	clsPick.put("45","45 - Personal & Social, Legal & Security Services");
	// ---------- 5. One Deal per brand ----------------------------------
	brands = p.get("brands");
	made = 0;
	dealNote = "";
	if(brands != null)
	{
		for each b in brands
		{
			bn = "";
			if(b.get("brand_name") != null)
			{
				bn = b.get("brand_name").toString().trim();
			}
			if(bn != "")
			{
				// Types = what they actually gave us for THIS brand.
				types = "";
				types = "Word";
				hasLogo = false;
				if(b.get("logo_flag") != null && b.get("logo_flag") == true)
				{
					hasLogo = true;
				}
				if(b.get("logo_later") != null && b.get("logo_later") == true)
				{
					hasLogo = true;
				}
				if(b.get("logo_url") != null && b.get("logo_url").toString() != "")
				{
					hasLogo = true;
				}
				if(hasLogo)
				{
					types = types + ", Logo";
				}
				dName = variant + " - " + bn + " " + types;
				if(dName.length() > 120)
				{
					dName = dName.subString(0,120);
				}
				dl = List();
				dl.add("Brand Audit request from the website.");
				dl.add("Variant: " + variant);
				dl.add("Mark types: " + types);
				if(b.get("tagline") != null && b.get("tagline").toString() != "")
				{
					// Tagline is a potentially separate registrable mark; it
					// stays ON this deal so the adviser prices it knowingly.
					dl.add("Tagline (possible separate mark): " + b.get("tagline").toString());
				}
				if(b.get("logo_later") != null && b.get("logo_later") == true)
				{
					dl.add("Logo: client will send it later.");
				}
				if(b.get("website_url") != null && b.get("website_url").toString() != "")
				{
					dl.add("Brand website: " + b.get("website_url").toString());
				}
				if(b.get("business_description") != null && b.get("business_description").toString() != "")
				{
					dl.add("What they do: " + b.get("business_description").toString());
				}
				if(b.get("competitor_name") != null && b.get("competitor_name").toString() != "")
				{
					dl.add("Competitor named: " + b.get("competitor_name").toString());
				}
				if(p.get("trading_now") != null)
				{
					dl.add("Trading now: " + p.get("trading_now").toString());
				}
				if(p.get("planning_to_trade") != null)
				{
					dl.add("Planning to trade: " + p.get("planning_to_trade").toString());
				}
				dDesc = "";
				for each dline in dl
				{
					if(dDesc != "")
					{
						dDesc = dDesc + nl;
					}
					dDesc = dDesc + dline;
				}
				dM = Map();
				dM.put("Deal_Name",dName);
				dM.put("Pipeline","Audit and Consultation");
				dM.put("Stage","Prospect");
				dM.put("Account_Name",accountId.toLong());
				dM.put("Contact_Name",contactId.toLong());
				dM.put("Lead_Source","Request Brand Audit Website Form");
				dM.put("Description",dDesc);
				nd = zoho.crm.createRecord("Deals",dM);
				if(nd.get("id") != null)
				{
					dealId = nd.get("id").toString();
					made = made + 1;
					// ----- scope asset + class rows for THIS brand -----
					amD = Map();
					aNm = "Brand Audit - " + bn;
					if(aNm.length() > 100)
					{
						aNm = aNm.subString(0,100);
					}
					amD.put("Name",aNm);
					amD.put("Deal",dealId.toLong());
					amD.put("Asset_Type","Deal Search");
					amD.put("Asset_Status","Active");
					amD.put("Register","UKIPO");
					if(accountId != "")
					{
						amD.put("Account",accountId.toLong());
					}
					caD = zoho.crm.createRecord("G_S_Scope_Assets",amD);
					assetD = "";
					if(caD.get("id") != null)
					{
						assetD = caD.get("id").toString();
					}
					ourCls = Map();
					if(assetD != "" && b.get("classes") != null)
					{
						tTxt = "";
						if(b.get("terms") != null)
						{
							for each tm in b.get("terms")
							{
								if(tTxt != "")
								{
									tTxt = tTxt + nl;
								}
								tTxt = tTxt + tm.toString();
							}
						}
						for each cn in b.get("classes")
						{
							nnD = cn.toString();
							if(cn.toLong() < 10)
							{
								nnD = "0" + nnD;
							}
							rM = Map();
							rM.put("Name","Class " + nnD + " - " + bn);
							rM.put("Scope_Asset",assetD.toLong());
							rM.put("Nice_Class_Number_Snapshot",cn.toLong());
							rM.put("Nice_Class_Reference",1964745000114603017 + cn.toLong());
							rM.put("Register_Snapshot","UKIPO");
							rM.put("Terms_Source","Approved");
							if(tTxt != "")
							{
								rM.put("Specific_Terms",tTxt);
							}
							cr = zoho.crm.createRecord("G_S_Scope_Classes_Terms",rM);
							// sub-form row for the same class
							if(clsPick.get(cn.toLong().toString()) != null)
							{
								rw = Map();
								lst = List();
								lst.add(clsPick.get(cn.toLong().toString()));
								rw.put("Classes",lst);
								rw.put("Terms1",tTxt);
								ourCls.put(cn.toLong().toString(),rw);
							}
						}
					}
					// ----- mirror into the Deal's Classes Terms sub-form ---
					if(ourCls.isEmpty() == false)
					{
						subNew = List();
						for each k2 in ourCls.keys()
						{
							subNew.add(ourCls.get(k2));
						}
						sfMap = Map();
						sfMap.put("Classes_Terms",subNew);
						sfU = zoho.crm.updateRecord("Deals",dealId.toLong(),sfMap);
					}
					// Pipeline/Stage LAST. Zoho ignores them on CREATE (the
					// layout default wins — proven 21 Aug), and the sub-form
					// write above re-applies that default too, so this has to
					// be the final word on the record (proven 27 Aug: set it
					// before the sub-form and the deal lands in the wrong
					// pipeline).
					pM = Map();
					pM.put("Pipeline","Audit and Consultation");
					pM.put("Stage","Prospect");
					pu = zoho.crm.updateRecord("Deals",dealId.toLong(),pM);
					dealNote = dealNote + ":deal=" + dealId;
				}
				else
				{
					info "audit: deal create FAILED for " + bn + " -> " + nd;
				}
			}
		}
	}
	// ---------- 6. Callback so the journey row knows where it landed ---
	cb = Map();
	cb.put("request_id",p.get("request_id"));
	cb.put("zoho_contact_id",contactId);
	cb.put("zoho_account_id",accountId);
	res = invokeurl
	[
		url : "https://jwanlhdmhgmbybcdhvkx.supabase.co/functions/v1/journey/zoho-linked"
		type : POST
		parameters : cb.toString()
		headers : {"Content-Type":"application/json"}
	];
	return "ok:contact=" + contactId + ":account=" + accountId + ":deals+" + made + dealNote + converted;
}
